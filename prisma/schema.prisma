model EmployeeCompensationVersion {
  id                  String                            @id @default(uuid()) @db.Uuid
  businessId          String                            @map("business_id") @db.Uuid
  membershipId        String                            @map("membership_id") @db.Uuid
  effectiveFromMonth  DateTime                          @map("effective_from_month") @db.Date
  payBasis            EmployeePayBasis                  @map("pay_basis")
  baseRate            Decimal                           @map("base_rate") @db.Decimal(12, 2)
  status              EmployeeCompensationVersionStatus @default(ACTIVE)
  source              EmployeeCompensationSource
  reasonType          EmployeeCompensationReasonType    @map("reason_type")
  reasonNote          String?                           @map("reason_note")
  createdAt           DateTime                          @default(now()) @map("created_at")
  createdById         String?                           @map("created_by_id") @db.Uuid
  updatedAt           DateTime                          @updatedAt @map("updated_at")
  supersedesVersionId String?                           @map("supersedes_version_id") @db.Uuid
  supersededAt        DateTime?                         @map("superseded_at")
  supersededById      String?                           @map("superseded_by_id") @db.Uuid

  business           Business                            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  membership         EmployeeBusinessMembership          @relation(fields: [membershipId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy          User?                               @relation("CompensationVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  supersededBy       User?                               @relation("CompensationVersionSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedesVersion  EmployeeCompensationVersion?        @relation("CompensationVersionSupersession", fields: [supersedesVersionId], references: [id], onDelete: Restrict)
  supersededVersions EmployeeCompensationVersion[]       @relation("CompensationVersionSupersession")
  payrollEntries     PayrollEntry[]
  workPaySnapshots   PayrollWorkPayCalculationSnapshot[]

  @@unique([id, businessId])
  @@index([businessId, membershipId, effectiveFromMonth])
  @@index([membershipId, status, effectiveFromMonth])
  @@index([supersedesVersionId])
  @@map("employee_compensation_versions")
}

model EmployeeRecurringPayComponent {
