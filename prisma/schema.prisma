generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  active
  inactive
}

enum BusinessIndustry {
  AUTO_DETAILING
  SALON_BEAUTY
  PET_GROOMING
  DEVICE_REPAIR
  BICYCLE_REPAIR
  SHOE_CLEANING
  LAUNDRY
  WATCH_REPAIR
  GENERAL_SERVICE
}

enum BusinessLanguage {
  EN
  ZH
}

enum DailyClosingStatus {
  CLOSED
}

enum UserRole {
  PLATFORM_ADMIN
  BUSINESS_OWNER
  STAFF
}

enum UserStatus {
  active
  inactive
}

enum EmployeeAccountStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeMembershipStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeAttendanceStatus {
  OPEN
  CLOSED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductCategoryStatus {
  ACTIVE
  INACTIVE
}

enum ServiceCategoryStatus {
  ACTIVE
  INACTIVE
}

enum CatalogDiscountScope {
  ALL
  SERVICES
  PRODUCTS
  PACKAGES
}

enum CatalogDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum WorkOrderStatus {
  WAITING
  IN_PROGRESS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum WorkOrderContactType {
  REGISTERED_OWNER
  OTHER_PERSON
  NEW_OWNER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  DUITNOW
  EWALLET
  BANK_TRANSFER
  PACKAGE
}

enum PaymentRecordStatus {
  ACTIVE
  VOID
}

enum CashierShiftStatus {
  OPEN
  CLOSED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  VOID
}

enum WhatsAppMessageType {
  NEW_CUSTOMER_WELCOME
  APPOINTMENT_REMINDER
  SERVICE_CONFIRMATION
  READY_FOR_PICKUP
  INVOICE_SENT
  INBOX_REPLY
  DAILY_CLOSING_REPORT
  DAILY_CLOSING_UNCLOSED_REMINDER
}

enum WhatsAppMessageStatus {
  DRAFT
  OPENED
  SENT_TO_SERVER
  SENT_MANUALLY
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum WhatsAppTemplateStatus {
  ACTIVE
  INACTIVE
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  QR_REQUIRED
  CONNECTED
  ERROR
}

enum WhatsAppWorkerCommandType {
  START_SESSION
  DISCONNECT
  SEND_TEXT
  SEND_DOCUMENT
}

enum WhatsAppWorkerCommandStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum WhatsAppChatDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppChatMessageStatus {
  RECEIVED
  SENT_TO_SERVER
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppChatMessageType {
  TEXT
  AUDIO
  DOCUMENT
  IMAGE
}

enum NotificationQueueStatus {
  QUEUED
  SENDING
  SENT
  SENT_TO_SERVER
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum NotificationQueuePriority {
  HIGH
  NORMAL
  LOW
}

enum ClosingWhatsAppRecipientRole {
  OWNER
  BRANCH_MANAGER
  FINANCE
}

enum ClosingWhatsAppRecipientScope {
  BUSINESS
  BRANCH
}

enum ClosingWhatsAppSendType {
  CLOSING_REPORT
  UNCLOSED_REMINDER
}

enum ClosingWhatsAppSendTrigger {
  AUTO_CLOSING
  AUTO_REMINDER
  MANUAL_RETRY
  MANUAL_RESEND
}

enum PackageStatus {
  ACTIVE
  INACTIVE
}

enum PackageCategoryStatus {
  ACTIVE
  INACTIVE
}

enum CustomerPackageStatus {
  PENDING_PAYMENT
  ACTIVE
  USED_UP
  CANCELLED
}

enum VehicleSize {
  UNCLASSIFIED
  SMALL
  MEDIUM
  LARGE
}

enum VehicleSizeSource {
  UNCLASSIFIED
  PLATFORM_DEFAULT
  BUSINESS_OVERRIDE
  MANUAL
}

enum PackageVehicleSize {
  ALL
  SMALL
  MEDIUM
  LARGE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  IN_SERVICE
  COMPLETED
  CONVERTED_TO_JOB
  CANCELLED
  NO_SHOW
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum LoyaltyTransactionType {
  EARN
  WELCOME_BONUS
  REDEEM
  REDEMPTION_REFUND
  REFUND_REVERSAL
  MANUAL_ADJUSTMENT
}

model Business {
  id                String           @id @default(uuid()) @db.Uuid
  name              String
  slug              String           @unique
  industryType      BusinessIndustry @default(AUTO_DETAILING) @map("industry_type")
  logoUrl           String?          @map("logo_url")
  companyNo         String?          @map("company_no")
  phone             String?
  email             String?
  address           String?
  language          BusinessLanguage @default(EN)
  sstEnabled        Boolean          @default(false) @map("sst_enabled")
  sstLabel          String           @default("SST") @map("sst_label")
  sstRate           Decimal          @default(0) @map("sst_rate") @db.Decimal(5, 2)
  sstRegistrationNo String?          @map("sst_registration_no")
  status            BusinessStatus   @default(active)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  users                      User[]
  customers                  Customer[]
  vehicles                   Vehicle[]
  serviceCategories          ServiceCategory[]
  services                   Service[]
  productCategories          ProductCategory[]
  products                   Product[]
  productStocks              ProductStock[]
  packageCategories          PackageCategory[]
  workOrders                 WorkOrder[]
  workOrderItems             WorkOrderItem[]
  invoiceItems               InvoiceItem[]
  creditNoteItems            CreditNoteItem[]
  payments                   Payment[]
  paymentRefunds             PaymentRefund[]
  creditNotes                CreditNote[]
  cashierShifts              CashierShift[]
  invoices                   Invoice[]
  whatsappMessages           WhatsAppMessage[]
  whatsappConnection         WhatsAppConnection?
  whatsappConversations      WhatsAppConversation[]
  whatsappChatMessages       WhatsAppChatMessage[]
  whatsappContacts           WhatsAppContact[]
  whatsappWorkerCommands     WhatsAppWorkerCommand[]
  notificationQueues         NotificationQueue[]
  packages                   Package[]
  customerPackages           CustomerPackage[]
  packageServiceBenefits     PackageServiceBenefit[]
  customerPackageBalances    CustomerPackageServiceBalance[]
  vehicleSizeOverrides       BusinessVehicleSizeOverride[]
  branches                   Branch[]
  vehicleOwnershipHistories  VehicleOwnershipHistory[]
  appointments               Appointment[]
  auditLogs                  AuditLog[]
  loyaltyProgram             LoyaltyProgram?
  customerMemberships        CustomerMembership[]
  loyaltyTransactions        LoyaltyTransaction[]
  serviceStaffAssignments    ServiceStaffAssignment[]
  staffAvailabilities        StaffAvailability[]
  staffBreaks                StaffBreak[]
  staffTimeOff               StaffTimeOff[]
  appointmentReminderSetting AppointmentReminderSetting?
  employeeMemberships        EmployeeBusinessMembership[]
  employeeBranchAssignments  EmployeeBranchAssignment[]
  employeeAttendances        EmployeeAttendance[]
  catalogDiscounts           CatalogDiscount[]
  staffRoleProfiles          StaffRoleProfile[]
  staffLevels                StaffLevel[]
  dailyClosingSnapshots      DailyClosingSnapshot[]
  closingWhatsAppSetting        ClosingWhatsAppSetting?
  closingWhatsAppBranchSettings ClosingWhatsAppBranchSetting[]
  closingWhatsAppRecipients     ClosingWhatsAppRecipient[]
  closingWhatsAppSends          ClosingWhatsAppSendAttempt[]

  @@index([slug])
  @@index([industryType])
  @@map("businesses")
}

model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  name       String
  phone      String?
  address    String?
  status     BranchStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  business                  Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customers                 Customer[]
  vehicles                  Vehicle[]
  services                  Service[]
  productStocks             ProductStock[]
  packages                  Package[]
  customerPackages          CustomerPackage[]
  staffUsers                User[]
  workOrders                WorkOrder[]
  payments                  Payment[]
  paymentRefunds            PaymentRefund[]
  creditNotes               CreditNote[]
  cashierShifts             CashierShift[]
  invoices                  Invoice[]
  whatsappMessages          WhatsAppMessage[]
  notificationQueues        NotificationQueue[]
  vehicleOwnershipHistories VehicleOwnershipHistory[]
  appointments              Appointment[]
  auditLogs                 AuditLog[]
  loyaltyTransactions       LoyaltyTransaction[]
  employeeBranchAssignments EmployeeBranchAssignment[]
  employeeAttendances       EmployeeAttendance[]
  catalogDiscounts          CatalogDiscount[]
  dailyClosingSnapshots     DailyClosingSnapshot[]
  closingWhatsAppSetting    ClosingWhatsAppBranchSetting?
  closingWhatsAppRecipients ClosingWhatsAppRecipient[]
  closingWhatsAppSends      ClosingWhatsAppSendAttempt[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([status])
  @@map("branches")
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  businessId          String?    @map("business_id") @db.Uuid
  branchId            String?    @map("branch_id") @db.Uuid
  name                String
  email               String?    @unique
  whatsappPhone       String?    @map("whatsapp_phone")
  passwordHash        String?    @map("password_hash")
  loginEnabled        Boolean    @default(true) @map("login_enabled")
  appointmentBookable Boolean    @default(false) @map("appointment_bookable")
  employeeAccountId   String?    @map("employee_account_id") @db.Uuid
  staffRoleProfileId  String?    @map("staff_role_profile_id") @db.Uuid
  staffLevelId        String?    @map("staff_level_id") @db.Uuid
  role                UserRole
  permissions         String[]   @default([])
  status              UserStatus @default(active)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  business                 Business?                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch                   Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  cashierShifts            CashierShift[]           @relation("CashierShiftCashier")
  cashierPayments          Payment[]                @relation("PaymentCashier")
  processedPaymentRefunds  PaymentRefund[]          @relation("PaymentRefundProcessor")
  createdCreditNotes       CreditNote[]             @relation("CreditNoteCreator")
  sentWhatsAppMessages     WhatsAppMessage[]        @relation("WhatsAppMessageSender")
  sentWhatsAppChatMessages WhatsAppChatMessage[]    @relation("WhatsAppChatMessageSender")
  createdAppointments      Appointment[]            @relation("AppointmentCreatedBy")
  assignedAppointments     Appointment[]            @relation("AppointmentAssignedStaff")
  auditLogs                AuditLog[]               @relation("AuditLogActor")
  loyaltyTransactions      LoyaltyTransaction[]     @relation("LoyaltyTransactionCreator")
  serviceStaffAssignments  ServiceStaffAssignment[]
  staffAvailabilities      StaffAvailability[]
  staffBreaks              StaffBreak[]
  staffTimeOff             StaffTimeOff[]
  employeeAccount          EmployeeAccount?         @relation("EmployeeAccountLegacyUsers", fields: [employeeAccountId], references: [id], onDelete: SetNull)
  staffRoleProfile         StaffRoleProfile?        @relation(fields: [staffRoleProfileId], references: [id], onDelete: SetNull)
  staffLevel               StaffLevel?              @relation(fields: [staffLevelId], references: [id], onDelete: SetNull)
  closedDailySnapshots     DailyClosingSnapshot[]  @relation("DailyClosingClosedBy")
  closingWhatsAppSends     ClosingWhatsAppSendAttempt[] @relation("ClosingWhatsAppRequestedBy")

  @@index([businessId])
  @@index([branchId])
  @@index([role])
  @@index([staffRoleProfileId])
  @@index([staffLevelId])
  @@map("users")
}

model StaffRoleProfile {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String
  permissions String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  users    User[]

  @@unique([businessId, name])
  @@index([businessId, active])
  @@map("staff_role_profiles")
}

model StaffLevel {
  id                 String   @id @default(uuid()) @db.Uuid
  businessId         String   @map("business_id") @db.Uuid
  name               String
  serviceFixedAmount Decimal  @default(0) @map("service_fixed_amount") @db.Decimal(10, 2)
  servicePercent     Decimal  @default(0) @map("service_percent") @db.Decimal(5, 2)
  productFixedAmount Decimal  @default(0) @map("product_fixed_amount") @db.Decimal(10, 2)
  productPercent     Decimal  @default(0) @map("product_percent") @db.Decimal(5, 2)
  packageFixedAmount Decimal  @default(0) @map("package_fixed_amount") @db.Decimal(10, 2)
  packagePercent     Decimal  @default(0) @map("package_percent") @db.Decimal(5, 2)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  users    User[]

  @@unique([businessId, name])
  @@index([businessId, active])
  @@map("staff_levels")
}

// Industry-neutral employee identity used by the future staff app.
// One employee can belong to multiple businesses and branches without
// duplicating the global phone identity.
model EmployeeAccount {
  id              String                @id @default(uuid()) @db.Uuid
  phoneNormalized String                @unique @map("phone_normalized")
  name            String
  status          EmployeeAccountStatus @default(ACTIVE)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  legacyUsers User[]                       @relation("EmployeeAccountLegacyUsers")
  memberships EmployeeBusinessMembership[]
  attendances EmployeeAttendance[]

  @@index([status])
  @@map("employee_accounts")
}

model EmployeeBusinessMembership {
  id                String                   @id @default(uuid()) @db.Uuid
  employeeAccountId String                   @map("employee_account_id") @db.Uuid
  businessId        String                   @map("business_id") @db.Uuid
  status            EmployeeMembershipStatus @default(ACTIVE)
  position          String?
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  employeeAccount   EmployeeAccount            @relation(fields: [employeeAccountId], references: [id], onDelete: Cascade)
  business          Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchAssignments EmployeeBranchAssignment[]
  attendances       EmployeeAttendance[]

  @@unique([employeeAccountId, businessId])
  @@index([businessId, status])
  @@index([employeeAccountId, status])
  @@map("employee_business_memberships")
}

model EmployeeBranchAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  membership EmployeeBusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  business   Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch                     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([membershipId, branchId])
  @@index([businessId, branchId])
  @@index([branchId])
  @@map("employee_branch_assignments")
}

model EmployeeAttendance {
  id                String                   @id @default(uuid()) @db.Uuid
  employeeAccountId String                   @map("employee_account_id") @db.Uuid
  membershipId      String                   @map("membership_id") @db.Uuid
  businessId        String                   @map("business_id") @db.Uuid
  branchId          String                   @map("branch_id") @db.Uuid
  status            EmployeeAttendanceStatus @default(OPEN)
  clockInAt         DateTime                 @default(now()) @map("clock_in_at")
  clockOutAt        DateTime?                @map("clock_out_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  employeeAccount EmployeeAccount            @relation(fields: [employeeAccountId], references: [id], onDelete: Restrict)
  membership      EmployeeBusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  business        Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch          Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([businessId, branchId, clockInAt])
  @@index([employeeAccountId, status])
  @@index([membershipId, status])
  @@map("employee_attendance")
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  name           String
  phone          String
  email          String?
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  notes          String?
  preferences    String?
  treatmentNotes String?   @map("treatment_notes")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  business                  Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch                    Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vehicles                  Vehicle[]
  workOrders                WorkOrder[]
  whatsappMessages          WhatsAppMessage[]
  whatsappConversations     WhatsAppConversation[]
  whatsappChatMessages      WhatsAppChatMessage[]
  customerPackages          CustomerPackage[]
  previousVehicleOwnerships VehicleOwnershipHistory[] @relation("PreviousVehicleOwner")
  newVehicleOwnerships      VehicleOwnershipHistory[] @relation("NewVehicleOwner")
  appointments              Appointment[]
  membership                CustomerMembership?
  loyaltyTransactions       LoyaltyTransaction[]
  invoices                  Invoice[]
  creditNotes               CreditNote[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([branchId])
  @@map("customers")
}

model Vehicle {
  id          String            @id @default(uuid()) @db.Uuid
  businessId  String            @map("business_id") @db.Uuid
  branchId    String?           @map("branch_id") @db.Uuid
  customerId  String            @map("customer_id") @db.Uuid
  plateNumber String            @map("plate_number")
  brand       String?
  model       String?
  color       String?
  size        VehicleSize       @default(UNCLASSIFIED)
  sizeSource  VehicleSizeSource @default(UNCLASSIFIED) @map("size_source")
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  business           Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch             Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer           Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  workOrders         WorkOrder[]
  whatsappMessages   WhatsAppMessage[]
  ownershipHistories VehicleOwnershipHistory[]
  appointments       Appointment[]

  @@unique([businessId, plateNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([customerId])
  @@index([businessId, size])
  @@map("vehicles")
}

model VehicleModelSizeDefault {
  id              String      @id @default(uuid()) @db.Uuid
  brand           String
  model           String
  normalizedBrand String      @map("normalized_brand")
  normalizedModel String      @map("normalized_model")
  size            VehicleSize
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([normalizedBrand, normalizedModel], map: "vehicle_model_size_defaults_brand_model_key")
  @@index([active])
  @@index([size])
  @@map("vehicle_model_size_defaults")
}

model BusinessVehicleSizeOverride {
  id              String      @id @default(uuid()) @db.Uuid
  businessId      String      @map("business_id") @db.Uuid
  brand           String
  model           String
  normalizedBrand String      @map("normalized_brand")
  normalizedModel String      @map("normalized_model")
  size            VehicleSize
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, normalizedBrand, normalizedModel], map: "business_vehicle_size_overrides_lookup_key")
  @@index([businessId, size], map: "business_vehicle_size_overrides_business_size_idx")
  @@map("business_vehicle_size_overrides")
}

model ServiceCategory {
  id         String                @id @default(uuid()) @db.Uuid
  businessId String                @map("business_id") @db.Uuid
  name       String
  status     ServiceCategoryStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  services Service[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([status])
  @@map("service_categories")
}

model Service {
  id              String        @id @default(uuid()) @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  branchId        String?       @map("branch_id") @db.Uuid
  categoryId      String?       @map("category_id") @db.Uuid
  name            String
  category        String?
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  durationMinutes Int?          @map("duration_minutes")
  taxable         Boolean       @default(true)
  taxRate         Decimal?      @map("tax_rate") @db.Decimal(5, 2)
  status          ServiceStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  business         Business                        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch           Branch?                         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  serviceCategory  ServiceCategory?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items            WorkOrderItem[]
  packages         Package[]
  packageBenefits  PackageServiceBenefit[]
  packageBalances  CustomerPackageServiceBalance[]
  appointments     Appointment[]
  staffAssignments ServiceStaffAssignment[]
  invoiceItems     InvoiceItem[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, category])
  @@index([branchId])
  @@index([categoryId])
  @@map("services")
}

model ServiceStaffAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("service_staff_assignments")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  businessId  String        @map("business_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  name        String
  sku         String?
  description String?
  category    String?
  price       Decimal       @db.Decimal(10, 2)
  costPrice   Decimal?      @map("cost_price") @db.Decimal(10, 2)
  taxable     Boolean       @default(false)
  taxRate     Decimal?      @map("tax_rate") @db.Decimal(5, 2)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productCategory ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stocks          ProductStock[]
  invoiceItems    InvoiceItem[]

  @@unique([businessId, name])
  @@index([businessId, status])
  @@index([businessId, category])
  @@index([categoryId])
  @@map("products")
}

model ProductCategory {
  id         String                @id @default(uuid()) @db.Uuid
  businessId String                @map("business_id") @db.Uuid
  name       String
  status     ProductCategoryStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([businessId, name])
