generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  active
  inactive
}

enum UserRole {
  PLATFORM_ADMIN
  BUSINESS_OWNER
  STAFF
}

enum UserStatus {
  active
  inactive
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum ServiceCategoryStatus {
  ACTIVE
  INACTIVE
}

enum WorkOrderStatus {
  WAITING
  IN_PROGRESS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum WorkOrderContactType {
  REGISTERED_OWNER
  OTHER_PERSON
  NEW_OWNER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  CARD
  DUITNOW
  EWALLET
  BANK_TRANSFER
  PACKAGE
}

enum PaymentRecordStatus {
  ACTIVE
  VOID
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

enum WhatsAppMessageType {
  NEW_CUSTOMER_WELCOME
  SERVICE_CONFIRMATION
  READY_FOR_PICKUP
  INVOICE_SENT
}

enum WhatsAppMessageStatus {
  DRAFT
  OPENED
  SENT_MANUALLY
  CANCELLED
}

enum WhatsAppTemplateStatus {
  ACTIVE
  INACTIVE
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  QR_REQUIRED
  CONNECTED
  ERROR
}

enum WhatsAppChatDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppChatMessageStatus {
  RECEIVED
  SENT
  FAILED
}

enum WhatsAppChatMessageType {
  TEXT
  AUDIO
}

enum PackageStatus {
  ACTIVE
  INACTIVE
}

enum PackageCategoryStatus {
  ACTIVE
  INACTIVE
}

enum CustomerPackageStatus {
  PENDING_PAYMENT
  ACTIVE
  USED_UP
  CANCELLED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model Business {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  slug      String         @unique
  logoUrl   String?        @map("logo_url")
  companyNo String?        @map("company_no")
  phone     String?
  email     String?
  address   String?
  status    BusinessStatus @default(active)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  users                     User[]
  customers                 Customer[]
  vehicles                  Vehicle[]
  serviceCategories         ServiceCategory[]
  services                  Service[]
  packageCategories         PackageCategory[]
  workOrders                WorkOrder[]
  workOrderItems            WorkOrderItem[]
  payments                  Payment[]
  invoices                  Invoice[]
  whatsappMessages          WhatsAppMessage[]
  whatsappConnection        WhatsAppConnection?
  whatsappConversations     WhatsAppConversation[]
  whatsappChatMessages      WhatsAppChatMessage[]
  packages                  Package[]
  customerPackages          CustomerPackage[]
  branches                  Branch[]
  vehicleOwnershipHistories VehicleOwnershipHistory[]

  @@index([slug])
  @@map("businesses")
}

model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  name       String
  phone      String?
  address    String?
  status     BranchStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  business                  Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customers                 Customer[]
  vehicles                  Vehicle[]
  services                  Service[]
  packages                  Package[]
  customerPackages          CustomerPackage[]
  workOrders                WorkOrder[]
  payments                  Payment[]
  invoices                  Invoice[]
  whatsappMessages          WhatsAppMessage[]
  vehicleOwnershipHistories VehicleOwnershipHistory[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([status])
  @@map("branches")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  businessId   String?    @map("business_id") @db.Uuid
  name         String
  email        String     @unique
  whatsappPhone String?   @map("whatsapp_phone")
  passwordHash String     @map("password_hash")
  role         UserRole
  permissions  String[]   @default([])
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sentWhatsAppMessages WhatsAppMessage[] @relation("WhatsAppMessageSender")
  sentWhatsAppChatMessages WhatsAppChatMessage[] @relation("WhatsAppChatMessageSender")

  @@index([businessId])
  @@index([role])
  @@map("users")
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  name       String
  phone      String
  email      String?
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business                  Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch                    Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vehicles                  Vehicle[]
  workOrders                WorkOrder[]
  whatsappMessages          WhatsAppMessage[]
  whatsappConversations     WhatsAppConversation[]
  whatsappChatMessages      WhatsAppChatMessage[]
  customerPackages          CustomerPackage[]
  previousVehicleOwnerships VehicleOwnershipHistory[] @relation("PreviousVehicleOwner")
  newVehicleOwnerships      VehicleOwnershipHistory[] @relation("NewVehicleOwner")

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([branchId])
  @@map("customers")
}

model Vehicle {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  plateNumber String   @map("plate_number")
  brand       String?
  model       String?
  color       String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business           Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch             Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer           Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  workOrders         WorkOrder[]
  whatsappMessages   WhatsAppMessage[]
  ownershipHistories VehicleOwnershipHistory[]

  @@unique([businessId, plateNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([customerId])
  @@map("vehicles")
}

model ServiceCategory {
  id         String                @id @default(uuid()) @db.Uuid
  businessId String                @map("business_id") @db.Uuid
  name       String
  status     ServiceCategoryStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  services Service[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([status])
  @@map("service_categories")
}

model Service {
  id          String        @id @default(uuid()) @db.Uuid
  businessId  String        @map("business_id") @db.Uuid
  branchId    String?       @map("branch_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  name        String
  category    String?
  description String?
  price       Decimal       @db.Decimal(10, 2)
  status      ServiceStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch   Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  serviceCategory ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items    WorkOrderItem[]
  packages Package[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, category])
  @@index([branchId])
  @@index([categoryId])
  @@map("services")
}

model Package {
  id          String        @id @default(uuid()) @db.Uuid
  businessId  String        @map("business_id") @db.Uuid
  branchId    String?       @map("branch_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  serviceId   String?       @map("service_id") @db.Uuid
  name        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  totalUses   Int           @default(10) @map("total_uses")
  status      PackageStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  packageCategory  PackageCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  service          Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customerPackages CustomerPackage[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([branchId])
  @@index([categoryId])
  @@index([serviceId])
  @@index([status])
  @@map("packages")
}

model PackageCategory {
  id         String                @id @default(uuid()) @db.Uuid
  businessId String                @map("business_id") @db.Uuid
  name       String
  status     PackageCategoryStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  packages Package[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([status])
  @@map("package_categories")
}

model CustomerPackage {
  id            String                @id @default(uuid()) @db.Uuid
  businessId    String                @map("business_id") @db.Uuid
  branchId      String?               @map("branch_id") @db.Uuid
  customerId    String                @map("customer_id") @db.Uuid
  packageId     String                @map("package_id") @db.Uuid
  purchasePrice Decimal               @map("purchase_price") @db.Decimal(10, 2)
  totalUses     Int                   @map("total_uses")
  remainingUses Int                   @map("remaining_uses")
  status        CustomerPackageStatus @default(PENDING_PAYMENT)
  purchasedAt   DateTime              @default(now()) @map("purchased_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package  Package   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([businessId])
  @@index([branchId])
  @@index([customerId])
  @@index([packageId])
  @@index([status])
  @@map("customer_packages")
}

model WorkOrder {
  id            String               @id @default(uuid()) @db.Uuid
  businessId    String               @map("business_id") @db.Uuid
  branchId      String?              @map("branch_id") @db.Uuid
  customerId    String               @map("customer_id") @db.Uuid
  vehicleId     String               @map("vehicle_id") @db.Uuid
  orderNumber   String               @map("order_number")
  status        WorkOrderStatus      @default(WAITING)
  contactName   String?              @map("contact_name")
  contactPhone  String?              @map("contact_phone")
  contactType   WorkOrderContactType @default(REGISTERED_OWNER) @map("contact_type")
  subtotal      Decimal              @db.Decimal(10, 2)
  total         Decimal              @db.Decimal(10, 2)
  paidAmount    Decimal              @default(0) @map("paid_amount") @db.Decimal(10, 2)
  balance       Decimal              @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus        @default(UNPAID) @map("payment_status")
  notes         String?
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  items            WorkOrderItem[]
  payments         Payment[]
  invoice          Invoice?
  whatsappMessages WhatsAppMessage[]

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([paymentStatus])
  @@map("work_orders")
}

model VehicleOwnershipHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  businessId         String   @map("business_id") @db.Uuid
  branchId           String?  @map("branch_id") @db.Uuid
  vehicleId          String   @map("vehicle_id") @db.Uuid
  previousCustomerId String?  @map("previous_customer_id") @db.Uuid
  newCustomerId      String   @map("new_customer_id") @db.Uuid
  transferredAt      DateTime @default(now()) @map("transferred_at")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")

  business         Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  previousCustomer Customer? @relation("PreviousVehicleOwner", fields: [previousCustomerId], references: [id], onDelete: SetNull)
  newCustomer      Customer  @relation("NewVehicleOwner", fields: [newCustomerId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([branchId])
  @@index([vehicleId])
  @@index([previousCustomerId])
  @@index([newCustomerId])
  @@index([transferredAt])
  @@map("vehicle_ownership_histories")
}

model WorkOrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  serviceId   String?  @map("service_id") @db.Uuid
  name        String
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([workOrderId])
  @@index([serviceId])
  @@map("work_order_items")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  businessId        String        @map("business_id") @db.Uuid
  branchId          String?       @map("branch_id") @db.Uuid
  workOrderId       String?       @map("work_order_id") @db.Uuid
  customerPackageId String?       @map("customer_package_id") @db.Uuid
  amount            Decimal       @db.Decimal(10, 2)
  method            PaymentMethod
  status            PaymentRecordStatus @default(ACTIVE)
  packageUses       Int           @default(0) @map("package_uses")
  reference         String?
  paidAt            DateTime      @default(now()) @map("paid_at")
  voidedAt          DateTime?     @map("voided_at")
  voidReason        String?       @map("void_reason")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  workOrder       WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  customerPackage CustomerPackage? @relation(fields: [customerPackageId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([branchId])
  @@index([workOrderId])
  @@index([customerPackageId])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  businessId    String        @map("business_id") @db.Uuid
  branchId      String?       @map("branch_id") @db.Uuid
  workOrderId   String        @unique @map("work_order_id") @db.Uuid
  invoiceNumber String        @map("invoice_number")
  subtotal      Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @map("paid_amount") @db.Decimal(10, 2)
  balance       Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(UNPAID)
  issuedAt      DateTime      @default(now()) @map("issued_at")
  voidedAt      DateTime?     @map("voided_at")
  voidReason    String?       @map("void_reason")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  workOrder        WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  whatsappMessages WhatsAppMessage[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([status])
  @@map("invoices")
}

model WhatsAppMessage {
  id                String                @id @default(uuid()) @db.Uuid
  businessId        String                @map("business_id") @db.Uuid
  branchId          String?               @map("branch_id") @db.Uuid
  customerId        String?               @map("customer_id") @db.Uuid
  vehicleId         String?               @map("vehicle_id") @db.Uuid
  workOrderId       String?               @map("work_order_id") @db.Uuid
  invoiceId         String?               @map("invoice_id") @db.Uuid
  sentByUserId      String?               @map("sent_by_user_id") @db.Uuid
  phone             String
  senderPhone       String?               @map("sender_phone")
  recipientPhone    String?               @map("recipient_phone")
  messageType       WhatsAppMessageType   @map("message_type")
  messageBody       String                @map("message_body")
  status            WhatsAppMessageStatus @default(DRAFT)
  provider          String?
  providerMessageId String?               @map("provider_message_id")
  errorMessage      String?               @map("error_message")
  queuedAt          DateTime?             @map("queued_at")
  sentAt            DateTime?             @map("sent_at")
  openedAt          DateTime?             @map("opened_at")
  deliveredAt       DateTime?             @map("delivered_at")
  readAt            DateTime?             @map("read_at")
  failedAt          DateTime?             @map("failed_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  invoice   Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  sentByUser User?     @relation("WhatsAppMessageSender", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([branchId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([workOrderId])
  @@index([invoiceId])
  @@index([sentByUserId])
  @@index([status])
  @@index([messageType])
  @@map("whatsapp_messages")
}

model WhatsAppTemplate {
  id          String                 @id @default(uuid()) @db.Uuid
  messageType WhatsAppMessageType    @unique @map("message_type")
  title       String
  body        String
  status      WhatsAppTemplateStatus @default(ACTIVE)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@index([status])
  @@map("whatsapp_templates")
}

model WhatsAppConnection {
  id             String                   @id @default(uuid()) @db.Uuid
  businessId     String                   @unique @map("business_id") @db.Uuid
  phoneNumber    String?                  @map("phone_number")
  status         WhatsAppConnectionStatus @default(DISCONNECTED)
  qrCodeText     String?                  @map("qr_code_text")
  sessionName    String?                  @map("session_name")
  connectedAt    DateTime?                @map("connected_at")
  disconnectedAt DateTime?                @map("disconnected_at")
  lastSeenAt     DateTime?                @map("last_seen_at")
  errorMessage   String?                  @map("error_message")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("whatsapp_connections")
}

model WhatsAppConversation {
    id              String                @id @default(uuid()) @db.Uuid
    businessId      String                @map("business_id") @db.Uuid
    customerId      String?               @map("customer_id") @db.Uuid
    phone           String
    remoteJid       String?               @map("remote_jid")
    displayName     String                @map("display_name")
    lastMessageBody String?               @map("last_message_body")
    lastMessageAt   DateTime?             @map("last_message_at")
    unreadCount     Int                   @default(0) @map("unread_count")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  business Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages WhatsAppChatMessage[]

    @@unique([businessId, phone])
    @@index([businessId])
    @@index([customerId])
    @@index([remoteJid])
    @@index([lastMessageAt])
    @@map("whatsapp_conversations")
  }

model WhatsAppChatMessage {
  id                String                    @id @default(uuid()) @db.Uuid
  businessId        String                    @map("business_id") @db.Uuid
  conversationId    String                    @map("conversation_id") @db.Uuid
  customerId        String?                   @map("customer_id") @db.Uuid
  sentByUserId      String?                   @map("sent_by_user_id") @db.Uuid
  direction         WhatsAppChatDirection
  messageType       WhatsAppChatMessageType   @default(TEXT) @map("message_type")
  body              String
  mediaUrl          String?                   @map("media_url")
  mediaMimeType     String?                   @map("media_mime_type")
  mediaFileName     String?                   @map("media_file_name")
  status            WhatsAppChatMessageStatus @default(SENT)
  externalMessageId String?                   @map("external_message_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sentByUser   User?                @relation("WhatsAppChatMessageSender", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([conversationId])
  @@index([customerId])
  @@index([sentByUserId])
  @@index([messageType])
  @@index([createdAt])
  @@map("whatsapp_chat_messages")
}
