model WhatsAppConnection {
  id                 String                   @id @default(uuid()) @db.Uuid
  businessId         String                   @unique @map("business_id") @db.Uuid
  phoneNumber        String?                  @map("phone_number")
  status             WhatsAppConnectionStatus @default(DISCONNECTED)
