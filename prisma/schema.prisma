// Industry-neutral employee identity used by the future staff app.
// One employee can belong to multiple businesses and branches without
// duplicating the global phone identity.
model EmployeeAccount {
  id              String                @id @default(uuid()) @db.Uuid
  phoneNumber     String                @map("phone_number")
  phoneNormalized String                @unique @map("phone_normalized")
  name            String
  status          EmployeeAccountStatus @default(ACTIVE)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  legacyUsers   User[]                       @relation("EmployeeAccountLegacyUsers")
  memberships   EmployeeBusinessMembership[]
  attendances   EmployeeAttendance[]
  otpChallenges EmployeeOtpChallenge[]
  devices       EmployeeDevice[]
  sessions      EmployeeSession[]

  @@index([status])
  @@map("employee_accounts")
}

model EmployeeOtpChallenge {
  id                    String             @id @default(uuid()) @db.Uuid
  employeeAccountId     String?            @map("employee_account_id") @db.Uuid
  phoneNumberNormalized String             @map("phone_number_normalized")
  purpose               EmployeeOtpPurpose
  // SMS123 challenges retain only a keyed OTP hash. Twilio Verify and current
  // mock challenges keep this null; legacy non-production mock rows may not.
  // Provider message codes are optional delivery metadata and remain nullable
  // for historical challenges created before forward hardening.
  otpHash               String?            @map("otp_hash")
  provider              String             @default("legacy_local")
  deliveryChannel       String             @default("local") @map("delivery_channel")
  providerReference     String?            @map("provider_reference")
  providerMessageCode   String?            @map("provider_message_code")
  deliveryAcceptedAt    DateTime?          @map("delivery_accepted_at")
  verificationAttemptId String?            @map("verification_attempt_id") @db.Uuid
  verificationStartedAt DateTime?          @map("verification_started_at")
  expiresAt             DateTime           @map("expires_at")
  attempts              Int                @default(0)
  maxAttempts           Int                @default(5) @map("max_attempts")
  resendAvailableAt     DateTime           @map("resend_available_at")
  verifiedAt            DateTime?          @map("verified_at")
  invalidatedAt         DateTime?          @map("invalidated_at")
  ipAddressHash         String?            @map("ip_address_hash")
  deviceFingerprintHash String?            @map("device_fingerprint_hash")
  createdAt             DateTime           @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("created_at")

  employeeAccount EmployeeAccount? @relation(fields: [employeeAccountId], references: [id], onDelete: SetNull)

  @@index([phoneNumberNormalized, purpose, createdAt], map: "employee_otp_challenges_phone_purpose_created_idx")
  @@index([employeeAccountId, createdAt], map: "employee_otp_challenges_account_created_idx")
  @@index([ipAddressHash, createdAt], map: "employee_otp_challenges_ip_created_idx")
  @@index([deviceFingerprintHash, createdAt], map: "employee_otp_challenges_device_created_idx")
  @@index([expiresAt], map: "employee_otp_challenges_expires_at_idx")
  @@map("employee_otp_challenges")
}

model EmployeeDevice {
  id                   String               @id @default(uuid()) @db.Uuid
  employeeAccountId    String               @map("employee_account_id") @db.Uuid
  deviceIdentifierHash String               @map("device_identifier_hash")
  displayName          String?              @map("display_name")
  platform             String?
  browser              String?
  firstVerifiedAt      DateTime             @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("first_verified_at")
  lastActiveAt         DateTime             @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("last_active_at")
  status               EmployeeDeviceStatus @default(ACTIVE)
  canView              Boolean              @default(true) @map("can_view")
  canPunch             Boolean              @default(true) @map("can_punch")
  revokedAt            DateTime?            @map("revoked_at")
  revokeReason         String?              @map("revoke_reason")
  createdAt            DateTime             @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  employeeAccount EmployeeAccount   @relation(fields: [employeeAccountId], references: [id], onDelete: Restrict)
  sessions        EmployeeSession[]

  @@unique([employeeAccountId, deviceIdentifierHash], map: "employee_devices_account_identifier_key")
  @@index([employeeAccountId, status, lastActiveAt], map: "employee_devices_account_status_active_idx")
  @@map("employee_devices")
}

model EmployeeSession {
  id                 String    @id @default(uuid()) @db.Uuid
  employeeAccountId  String    @map("employee_account_id") @db.Uuid
  membershipId       String    @map("membership_id") @db.Uuid
  businessId         String    @map("business_id") @db.Uuid
  primaryBranchId    String    @map("primary_branch_id") @db.Uuid
  attendanceBranchId String?   @map("attendance_branch_id") @db.Uuid
  employeeDeviceId   String?   @map("employee_device_id") @db.Uuid
  refreshTokenHash   String    @unique @map("refresh_token_hash")
  expiresAt          DateTime  @map("expires_at")
  lastActiveAt       DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("last_active_at")
  revokedAt          DateTime? @map("revoked_at")
  revokeReason       String?   @map("revoke_reason")
  ipAddressHash      String?   @map("ip_address_hash")
  userAgent          String?   @map("user_agent")
  createdAt          DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("created_at")

  employeeAccount            EmployeeAccount                @relation(fields: [employeeAccountId], references: [id], onDelete: Restrict)
  membership                 EmployeeBusinessMembership     @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  business                   Business                       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  primaryBranch              Branch                         @relation("EmployeeSessionPrimaryBranch", fields: [primaryBranchId], references: [id], onDelete: Restrict)
  attendanceBranch           Branch?                        @relation("EmployeeSessionAttendanceBranch", fields: [attendanceBranchId], references: [id], onDelete: Restrict)
  employeeDevice             EmployeeDevice?                @relation(fields: [employeeDeviceId], references: [id], onDelete: Restrict)
  idempotencyRequests        AttendanceRequestIdempotency[]
  attendanceResolutionEvents AttendanceResolutionEvent[]    @relation("AttendanceResolutionEventEmployeeSession")

  @@index([employeeAccountId, revokedAt, expiresAt], map: "employee_sessions_account_active_idx")
  @@index([membershipId, revokedAt, expiresAt], map: "employee_sessions_membership_active_idx")
  @@index([employeeDeviceId, revokedAt], map: "employee_sessions_device_active_idx")
  @@index([businessId, primaryBranchId], map: "employee_sessions_business_branch_idx")
  @@index([businessId, attendanceBranchId], map: "employee_sessions_business_attendance_branch_idx")
  @@map("employee_sessions")
}

