model Business {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String           @unique
  industryType          BusinessIndustry @default(AUTO_DETAILING) @map("industry_type")
  logoUrl               String?          @map("logo_url")
  companyNo             String?          @map("company_no")
  phone                 String?
  email                 String?
  address               String?
  language              BusinessLanguage @default(EN)
  timezone              String           @default("Asia/Kuching")
  businessDayCutoffTime String           @default("02:00") @map("business_day_cutoff_time")
  sstEnabled            Boolean          @default(false) @map("sst_enabled")
  sstLabel              String           @default("SST") @map("sst_label")
  sstRate               Decimal          @default(0) @map("sst_rate") @db.Decimal(5, 2)
  sstRegistrationNo     String?          @map("sst_registration_no")
  status                BusinessStatus   @default(active)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  users                         User[]
  customers                     Customer[]
  vehicles                      Vehicle[]
  serviceCategories             ServiceCategory[]
  services                      Service[]
  productCategories             ProductCategory[]
  products                      Product[]
  productStocks                 ProductStock[]
  packageCategories             PackageCategory[]
  workOrders                    WorkOrder[]
  workOrderItems                WorkOrderItem[]
  invoiceItems                  InvoiceItem[]
  creditNoteItems               CreditNoteItem[]
  payments                      Payment[]
  paymentRefunds                PaymentRefund[]
  creditNotes                   CreditNote[]
  cashierShifts                 CashierShift[]
  invoices                      Invoice[]
  whatsappMessages              WhatsAppMessage[]
  whatsappConnection            WhatsAppConnection?
  whatsappConversations         WhatsAppConversation[]
  whatsappChatMessages          WhatsAppChatMessage[]
  whatsappContacts              WhatsAppContact[]
  whatsappWorkerCommands        WhatsAppWorkerCommand[]
  notificationQueues            NotificationQueue[]
  packages                      Package[]
  customerPackages              CustomerPackage[]
  packageServiceBenefits        PackageServiceBenefit[]
  customerPackageBalances       CustomerPackageServiceBalance[]
  vehicleSizeOverrides          BusinessVehicleSizeOverride[]
  branches                      Branch[]
  vehicleOwnershipHistories     VehicleOwnershipHistory[]
  appointments                  Appointment[]
  auditLogs                     AuditLog[]
  loyaltyProgram                LoyaltyProgram?
  customerMemberships           CustomerMembership[]
  loyaltyTransactions           LoyaltyTransaction[]
  serviceStaffAssignments       ServiceStaffAssignment[]
  staffAvailabilities           StaffAvailability[]
  staffBreaks                   StaffBreak[]
  staffTimeOff                  StaffTimeOff[]
  appointmentReminderSetting    AppointmentReminderSetting?
  employeeMemberships           EmployeeBusinessMembership[]
  payrollSetting                PayrollSetting?
  payrollHolidays               PayrollHoliday[]
  payrollRuns                   PayrollRun[]
  payrollEntries                PayrollEntry[]
  compensationVersions          EmployeeCompensationVersion[]
  payrollProfileCommands        PayrollProfileCommandRecord[]
  statutoryProfile              BusinessStatutoryProfile?
  payrollStatutorySubmissions   PayrollStatutorySubmission[]
  payrollStatutoryArtifacts     PayrollStatutoryExportArtifact[]
  leavePolicies                 LeavePolicy[]
  employeeLeaveBalances         EmployeeLeaveBalance[]
  leaveRequests                 LeaveRequest[]
  leaveRequestDays              LeaveRequestDay[]
  employeeBranchAssignments     EmployeeBranchAssignment[]
  employeeAttendances           EmployeeAttendance[]
  branchAttendanceSettings      BranchAttendanceSetting[]
  attendancePunches             AttendancePunch[]
  attendanceExceptions          AttendanceException[]
  attendanceAdjustments         AttendanceAdjustment[]
  attendanceResolutionCases     AttendanceResolutionCase[]
  attendanceFinalResults        AttendanceFinalResult[]
  attendanceResolutionEvents    AttendanceResolutionEvent[]
  employeeSessions              EmployeeSession[]
  attendanceIdempotencyRequests AttendanceRequestIdempotency[]
  catalogDiscounts              CatalogDiscount[]
  staffRoleProfiles             StaffRoleProfile[]
  staffLevels                   StaffLevel[]
  analyticsDailySummaries       AnalyticsDailyStoreSummary[]
  analyticsPaymentSummaries     AnalyticsDailyPaymentMethodSummary[]
  dailyClosingSnapshots         DailyClosingSnapshot[]
  closingWhatsAppSetting        ClosingWhatsAppSetting?
  closingWhatsAppBranchSettings ClosingWhatsAppBranchSetting[]
  closingWhatsAppRecipients     ClosingWhatsAppRecipient[]
  closingWhatsAppSends          ClosingWhatsAppSendAttempt[]
  businessGroupMemberships      BusinessGroupMember[]
  businessGroupAccessGrants     BusinessGroupUserBusinessAccess[]
  businessGroupAuditEntries     BusinessGroupAuditLog[]

  @@index([slug])
  @@index([industryType])
  @@map("businesses")
}

model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  name       String
  phone      String?
  address    String?
  status     BranchStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  business                      Business                       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customers                     Customer[]
  vehicles                      Vehicle[]
  services                      Service[]
  productStocks                 ProductStock[]
  packages                      Package[]
  customerPackages              CustomerPackage[]
  staffUsers                    User[]
  workOrders                    WorkOrder[]
  payments                      Payment[]
  paymentRefunds                PaymentRefund[]
  creditNotes                   CreditNote[]
  cashierShifts                 CashierShift[]
  invoices                      Invoice[]
  whatsappMessages              WhatsAppMessage[]
  notificationQueues            NotificationQueue[]
  vehicleOwnershipHistories     VehicleOwnershipHistory[]
  appointments                  Appointment[]
  auditLogs                     AuditLog[]
  loyaltyTransactions           LoyaltyTransaction[]
  employeeBranchAssignments     EmployeeBranchAssignment[]
  payrollHolidays               PayrollHoliday[]
  employeeAttendances           EmployeeAttendance[]
  attendanceSetting             BranchAttendanceSetting?
  attendancePunches             AttendancePunch[]
  attendanceExceptions          AttendanceException[]
  attendanceAdjustments         AttendanceAdjustment[]
  attendanceResolutionCases     AttendanceResolutionCase[]
  attendanceFinalResults        AttendanceFinalResult[]
  attendanceResolutionEvents    AttendanceResolutionEvent[]
  primaryEmployeeSessions       EmployeeSession[]              @relation("EmployeeSessionPrimaryBranch")
  attendanceEmployeeSessions    EmployeeSession[]              @relation("EmployeeSessionAttendanceBranch")
  attendanceIdempotencyRequests AttendanceRequestIdempotency[]
  leaveRequests                 LeaveRequest[]
  catalogDiscounts              CatalogDiscount[]
  dailyClosingSnapshots         DailyClosingSnapshot[]
  closingWhatsAppSetting        ClosingWhatsAppBranchSetting?
  closingWhatsAppRecipients     ClosingWhatsAppRecipient[]
  closingWhatsAppSends          ClosingWhatsAppSendAttempt[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([status])
  @@map("branches")
}

model User {
  id                           String               @id @default(uuid()) @db.Uuid
  businessId                   String?              @map("business_id") @db.Uuid
  branchId                     String?              @map("branch_id") @db.Uuid
  name                         String
  email                        String?              @unique
  whatsappPhone                String?              @map("whatsapp_phone")
  passwordHash                 String?              @map("password_hash")
  loginEnabled                 Boolean              @default(true) @map("login_enabled")
  appointmentBookable          Boolean              @default(false) @map("appointment_bookable")
  employeeAccountId            String?              @map("employee_account_id") @db.Uuid
  employeeBusinessMembershipId String?              @unique @map("employee_business_membership_id") @db.Uuid
  teamMemberLinkStatus         TeamMemberLinkStatus @default(UNLINKED) @map("team_member_link_status")
  teamMemberLinkReason         String?              @map("team_member_link_reason")
  teamMemberLinkedAt           DateTime?            @map("team_member_linked_at")
  staffRoleProfileId           String?              @map("staff_role_profile_id") @db.Uuid
  staffLevelId                 String?              @map("staff_level_id") @db.Uuid
  role                         UserRole
  permissions                  String[]             @default([])
  status                       UserStatus           @default(active)
  createdAt                    DateTime             @default(now()) @map("created_at")
  updatedAt                    DateTime             @updatedAt @map("updated_at")

  business                          Business?                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch                            Branch?                      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  cashierShifts                     CashierShift[]               @relation("CashierShiftCashier")
  cashierPayments                   Payment[]                    @relation("PaymentCashier")
  processedPaymentRefunds           PaymentRefund[]              @relation("PaymentRefundProcessor")
  createdCreditNotes                CreditNote[]                 @relation("CreditNoteCreator")
  sentWhatsAppMessages              WhatsAppMessage[]            @relation("WhatsAppMessageSender")
  sentWhatsAppChatMessages          WhatsAppChatMessage[]        @relation("WhatsAppChatMessageSender")
  createdAppointments               Appointment[]                @relation("AppointmentCreatedBy")
  assignedAppointments              Appointment[]                @relation("AppointmentAssignedStaff")
  auditLogs                         AuditLog[]                   @relation("AuditLogActor")
  loyaltyTransactions               LoyaltyTransaction[]         @relation("LoyaltyTransactionCreator")
  serviceStaffAssignments           ServiceStaffAssignment[]
  staffAvailabilities               StaffAvailability[]
  staffBreaks                       StaffBreak[]
  staffTimeOff                      StaffTimeOff[]
  employeeAccount                   EmployeeAccount?             @relation("EmployeeAccountLegacyUsers", fields: [employeeAccountId], references: [id], onDelete: SetNull)
  employeeBusinessMembership        EmployeeBusinessMembership?  @relation("EmployeeBusinessMembershipStaffUser", fields: [employeeBusinessMembershipId], references: [id], onDelete: Restrict)
  staffRoleProfile                  StaffRoleProfile?            @relation(fields: [staffRoleProfileId], references: [id], onDelete: SetNull)
  staffLevel                        StaffLevel?                  @relation(fields: [staffLevelId], references: [id], onDelete: SetNull)
  closedDailySnapshots              DailyClosingSnapshot[]       @relation("DailyClosingClosedBy")
  closingWhatsAppSends              ClosingWhatsAppSendAttempt[] @relation("ClosingWhatsAppRequestedBy")
  businessGroupUsers                BusinessGroupUser[]
  businessGroupAuditEntries         BusinessGroupAuditLog[]
  reviewedAttendanceExceptions      AttendanceException[]        @relation("AttendanceExceptionReviewer")
  attendanceAdjustments             AttendanceAdjustment[]       @relation("AttendanceAdjustmentActor")
  attendanceResolutionCasesCreated  AttendanceResolutionCase[]   @relation("AttendanceResolutionCaseCreatedBy")
  attendanceResolutionCasesResolved AttendanceResolutionCase[]   @relation("AttendanceResolutionCaseResolvedBy")
  attendanceFinalResultsCreated     AttendanceFinalResult[]      @relation("AttendanceFinalResultCreatedBy")
  attendanceResolutionEvents        AttendanceResolutionEvent[]  @relation("AttendanceResolutionEventActorUser")
  reviewedLeaveRequests             LeaveRequest[]               @relation("LeaveRequestReviewer")

  payrollRunsCreated             PayrollRun[]                  @relation("PayrollRunCreatedBy")
  payrollRunsSubmitted           PayrollRun[]                  @relation("PayrollRunSubmittedBy")
  payrollRunsFinalized           PayrollRun[]                  @relation("PayrollRunFinalizedBy")
  compensationVersionsCreated    EmployeeCompensationVersion[] @relation("CompensationVersionCreatedBy")
  compensationVersionsSuperseded EmployeeCompensationVersion[] @relation("CompensationVersionSupersededBy")
  payrollProfileCommands         PayrollProfileCommandRecord[] @relation("PayrollProfileCommandActor")

  @@index([businessId])
  @@index([branchId])
  @@index([role])
  @@index([staffRoleProfileId])
  @@index([staffLevelId])
  @@map("users")
}

// A Business Group is a management and reporting layer above independent
// businesses. Transaction records remain owned by their existing businessId.
model BusinessGroup {
  id        String              @id @default(uuid()) @db.Uuid
  name      String
  code      String              @unique
  logoUrl   String?             @map("logo_url")
  status    BusinessGroupStatus @default(ACTIVE)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  members   BusinessGroupMember[]
  users     BusinessGroupUser[]
  auditLogs BusinessGroupAuditLog[]

  @@index([status])
  @@map("business_groups")
}

// Membership history is retained. A database partial unique index ensures a
// business can have only one ACTIVE membership across all groups.
model BusinessGroupMember {
  id         String                    @id @default(uuid()) @db.Uuid
  groupId    String                    @map("group_id") @db.Uuid
  businessId String                    @map("business_id") @db.Uuid
  status     BusinessGroupMemberStatus @default(ACTIVE)
  joinedAt   DateTime                  @default(now()) @map("joined_at")
  removedAt  DateTime?                 @map("removed_at")
  createdAt  DateTime                  @default(now()) @map("created_at")
  updatedAt  DateTime                  @updatedAt @map("updated_at")

  group    BusinessGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  business Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([groupId, status])
  @@index([businessId, status])
  @@index([groupId, businessId, joinedAt, removedAt])
  @@map("business_group_members")
}

// Group privileges are separate from UserRole so legacy BUSINESS_OWNER and
// STAFF semantics continue to apply within each individual business.
model BusinessGroupUser {
  id          String                   @id @default(uuid()) @db.Uuid
  groupId     String                   @map("group_id") @db.Uuid
  userId      String                   @map("user_id") @db.Uuid
  role        BusinessGroupUserRole
  status      BusinessGroupUserStatus  @default(ACTIVE)
  accessScope BusinessGroupAccessScope @default(ALL_GROUP_BUSINESSES) @map("access_scope")
  grantedAt   DateTime                 @default(now()) @map("granted_at")
  revokedAt   DateTime?                @map("revoked_at")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  group            BusinessGroup                     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user             User                              @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessAccesses BusinessGroupUserBusinessAccess[]

  @@index([groupId, status])
  @@index([userId, status])
  @@map("business_group_users")
}

// GROUP_MANAGER can be limited to selected businesses. GROUP_OWNER uses the
// ALL_GROUP_BUSINESSES scope and does not need rows here.
model BusinessGroupUserBusinessAccess {
  id          String   @id @default(uuid()) @db.Uuid
  groupUserId String   @map("group_user_id") @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  groupUser BusinessGroupUser @relation(fields: [groupUserId], references: [id], onDelete: Cascade)
  business  Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([groupUserId, businessId])
  @@index([businessId])
  @@map("business_group_user_business_access")
}

// Group actions cannot use AuditLog alone because it requires businessId.
// This table retains platform-level group, membership, and access history.
model BusinessGroupAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  businessId  String?  @map("business_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  summary     String
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  group    BusinessGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  business Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actor    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([businessId, createdAt])
