model AuthSession {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  activeBusinessId  String?   @map("active_business_id") @db.Uuid
  branchId          String?   @map("branch_id") @db.Uuid
  contextVersion    Int       @map("context_version")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  idleExpiresAt     DateTime  @map("idle_expires_at")
  lastActiveAt      DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("last_active_at")
  revokedAt         DateTime? @map("revoked_at")
  revokeReason      String?   @map("revoke_reason")
  ipAddressHash     String?   @map("ip_address_hash")
  userAgentHash     String?   @map("user_agent_hash")
  createdAt         DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user                          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sensitiveActionAuthorizations SensitiveActionAuthorization[]
  mfaEnrollmentCredentials      UserMfaCredential[]            @relation("MfaEnrollmentSession")

  @@index([userId, revokedAt, absoluteExpiresAt], map: "auth_sessions_user_active_idx")
  @@index([idleExpiresAt], map: "auth_sessions_idle_expires_idx")
  @@map("auth_sessions")
}

model SensitiveActionAuthorization {
  id                 String    @id @default(uuid()) @db.Uuid
  tokenHash          String    @unique @map("token_hash")
  userId             String    @map("user_id") @db.Uuid
  authSessionId      String    @map("auth_session_id") @db.Uuid
  businessId         String?   @map("business_id") @db.Uuid
  actionKey          String    @map("action_key")
  resourceType       String?   @map("resource_type")
  resourceId         String?   @map("resource_id")
  verificationMethod String    @map("verification_method")
  assuranceLevel     String    @map("assurance_level")
  requestFingerprint String?   @map("request_fingerprint")
  issuedAt           DateTime  @map("issued_at")
  expiresAt          DateTime  @map("expires_at")
  consumedAt         DateTime? @map("consumed_at")
  revokedAt          DateTime? @map("revoked_at")
  revokeReason       String?   @map("revoke_reason")
  createdAt          DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  authSession AuthSession @relation(fields: [authSessionId], references: [id], onDelete: Cascade)

  @@index([userId, actionKey, expiresAt], map: "sensitive_action_authorizations_user_action_idx")
  @@index([authSessionId, consumedAt, revokedAt, expiresAt], map: "sensitive_action_authorizations_session_state_idx")
  @@index([businessId, actionKey, expiresAt], map: "sensitive_action_authorizations_business_action_idx")
  @@map("sensitive_action_authorizations")
}

model UserMfaCredential {
  id                   String                  @id @default(uuid()) @db.Uuid
  userId               String                  @map("user_id") @db.Uuid
  type                 UserMfaCredentialType   @default(TOTP)
  status               UserMfaCredentialStatus @default(PENDING)
  encryptedSecret      Bytes                   @map("encrypted_secret")
  secretIv             Bytes                   @map("secret_iv")
  secretAuthTag        Bytes                   @map("secret_auth_tag")
  encryptionKeyVersion String                  @map("encryption_key_version") @db.VarChar(40)
  algorithm            String                  @default("SHA1") @db.VarChar(16)
  digits               Int                     @default(6)
  periodSeconds        Int                     @default(30) @map("period_seconds")
  enrollmentSessionId  String?                 @map("enrollment_session_id") @db.Uuid
  pendingExpiresAt     DateTime?               @map("pending_expires_at")
  enrolledAt           DateTime?               @map("enrolled_at")
  verifiedAt           DateTime?               @map("verified_at")
  lastAcceptedCounter  BigInt?                 @map("last_accepted_counter")
  recoveryVersion      Int                     @default(0) @map("recovery_version")
  revokedAt            DateTime?               @map("revoked_at")
  revokeReason         String?                 @map("revoke_reason") @db.VarChar(200)
  createdAt            DateTime                @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentSession AuthSession?          @relation("MfaEnrollmentSession", fields: [enrollmentSessionId], references: [id], onDelete: Cascade)
  recoveryCodes     UserMfaRecoveryCode[]

  @@index([userId, type, status], map: "user_mfa_credentials_user_type_status_idx")
  @@index([enrollmentSessionId, status, pendingExpiresAt], map: "user_mfa_credentials_enrollment_session_idx")
  @@map("user_mfa_credentials")
}

model UserMfaRecoveryCode {
  id           String    @id @default(uuid()) @db.Uuid
  credentialId String    @map("credential_id") @db.Uuid
  codeHash     String    @map("code_hash")
  generation   Int
  ordinal      Int
  createdAt    DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("created_at")
  consumedAt   DateTime? @map("consumed_at")
  revokedAt    DateTime? @map("revoked_at")

  credential UserMfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, generation, ordinal], map: "user_mfa_recovery_codes_generation_ordinal_key")
  @@index([credentialId, consumedAt, revokedAt], map: "user_mfa_recovery_codes_credential_state_idx")
  @@map("user_mfa_recovery_codes")
}

model AuthSecurityEvent {
  id             String   @id @default(uuid()) @db.Uuid
  eventType      String   @map("event_type")
  surface        String
  outcome        String
  identifierHash String?  @map("identifier_hash")
  ipAddressHash  String?  @map("ip_address_hash")
  userAgentHash  String?  @map("user_agent_hash")
  userId         String?  @map("user_id") @db.Uuid
  businessId     String?  @map("business_id") @db.Uuid
  sessionId      String?  @map("session_id") @db.Uuid
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("created_at")

  @@index([surface, identifierHash, createdAt], map: "auth_security_events_surface_identifier_idx")
  @@index([surface, ipAddressHash, createdAt], map: "auth_security_events_surface_ip_idx")
  @@index([eventType, createdAt], map: "auth_security_events_type_created_idx")
  @@index([userId, createdAt], map: "auth_security_events_user_created_idx")
  @@map("auth_security_events")
}

// A Business Group is a management and reporting layer above independent
// businesses. Transaction records remain owned by their existing businessId.
model BusinessGroup {
  id        String              @id @default(uuid()) @db.Uuid
  name      String
  code      String              @unique
  logoUrl   String?             @map("logo_url")
  status    BusinessGroupStatus @default(ACTIVE)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  members                 BusinessGroupMember[]
  users                   BusinessGroupUser[]
  auditLogs               BusinessGroupAuditLog[]
  aiConversations         AiConversation[]
  aiUsage                 AiUsage[]
  aiAllowancePolicies     AiAllowancePolicy[]
  aiAllowancePeriods      AiAllowancePeriod[]
  aiQuotaReservations     AiQuotaReservation[]
  aiUsageEvents           AiUsageEvent[]
  commercialSubscriptions CommercialSubscription[]
  commercialOverrides     CommercialOverride[]
  subscriptionInvoices    SubscriptionInvoice[]

  @@index([status])
  @@map("business_groups")
}

// Membership history is retained. A database partial unique index ensures a
// business can have only one ACTIVE membership across all groups.
model BusinessGroupMember {
  id         String                    @id @default(uuid()) @db.Uuid
  groupId    String                    @map("group_id") @db.Uuid
  businessId String                    @map("business_id") @db.Uuid
  status     BusinessGroupMemberStatus @default(ACTIVE)
  joinedAt   DateTime                  @default(now()) @map("joined_at")
  removedAt  DateTime?                 @map("removed_at")
  createdAt  DateTime                  @default(now()) @map("created_at")
  updatedAt  DateTime                  @updatedAt @map("updated_at")

  group    BusinessGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  business Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([groupId, status])
  @@index([businessId, status])
  @@index([groupId, businessId, joinedAt, removedAt])
  @@map("business_group_members")
}

// Group privileges are separate from UserRole so legacy BUSINESS_OWNER and
// STAFF semantics continue to apply within each individual business.
model BusinessGroupUser {
  id          String                   @id @default(uuid()) @db.Uuid
  groupId     String                   @map("group_id") @db.Uuid
  userId      String                   @map("user_id") @db.Uuid
  role        BusinessGroupUserRole
  status      BusinessGroupUserStatus  @default(ACTIVE)
  accessScope BusinessGroupAccessScope @default(ALL_GROUP_BUSINESSES) @map("access_scope")
  grantedAt   DateTime                 @default(now()) @map("granted_at")
  revokedAt   DateTime?                @map("revoked_at")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  group            BusinessGroup                     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user             User                              @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessAccesses BusinessGroupUserBusinessAccess[]

  @@index([groupId, status])
  @@index([userId, status])
  @@map("business_group_users")
}

// GROUP_MANAGER can be limited to selected businesses. GROUP_OWNER uses the
// ALL_GROUP_BUSINESSES scope and does not need rows here.
model BusinessGroupUserBusinessAccess {
  id          String   @id @default(uuid()) @db.Uuid
  groupUserId String   @map("group_user_id") @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  groupUser BusinessGroupUser @relation(fields: [groupUserId], references: [id], onDelete: Cascade)
  business  Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([groupUserId, businessId])
  @@index([businessId])
  @@map("business_group_user_business_access")
}

model AiConversation {
  id          String      @id @default(uuid()) @db.Uuid
  scopeType   AiScopeType @map("scope_type")
  businessId  String?     @map("business_id") @db.Uuid
  groupId     String?     @map("group_id") @db.Uuid
  createdById String      @map("created_by_id") @db.Uuid
  title       String?
  archivedAt  DateTime?   @map("archived_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  business          Business?            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  group             BusinessGroup?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy         User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  messages          AiMessage[]
  usage             AiUsage[]
  quotaReservations AiQuotaReservation[]
  usageEvents       AiUsageEvent[]

  @@index([businessId, createdById, updatedAt])
  @@index([groupId, createdById, updatedAt])
  @@index([createdById, archivedAt, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id                 String        @id @default(uuid()) @db.Uuid
  conversationId     String        @map("conversation_id") @db.Uuid
  role               AiMessageRole
  content            String
  structuredMetadata Json?         @map("structured_metadata")
  provider           String?
  model              String?
  promptVersion      String?       @map("prompt_version")
  contextVersion     String?       @map("context_version")
  contextDigest      String?       @map("context_digest")
  clientRequestId    String?       @map("client_request_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  usage        AiUsage[]

  @@unique([conversationId, clientRequestId])
  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiUsage {
  id                  String        @id @default(uuid()) @db.Uuid
  businessId          String?       @map("business_id") @db.Uuid
  groupId             String?       @map("group_id") @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  conversationId      String?       @map("conversation_id") @db.Uuid
  provider            String
  model               String
  requestKey          String        @map("request_key")
  inputTokens         Int?          @map("input_tokens")
  outputTokens        Int?          @map("output_tokens")
  totalTokens         Int?          @map("total_tokens")
  latencyMs           Int?          @map("latency_ms")
  status              AiUsageStatus
  errorCategory       String?       @map("error_category")
  messageId           String?       @map("message_id") @db.Uuid
  providerRequestId   String?       @map("provider_request_id")
  promptVersion       String?       @map("prompt_version")
  contextVersion      String?       @map("context_version")
  commerciallyCounted Boolean       @default(false) @map("commercially_counted")
  reservationId       String?       @unique @map("reservation_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at")

  business     Business?           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  group        BusinessGroup?      @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversation AiConversation?     @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message      AiMessage?          @relation(fields: [messageId], references: [id], onDelete: Restrict)
  reservation  AiQuotaReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  events       AiUsageEvent[]

  @@unique([userId, requestKey])
  @@index([businessId, userId, createdAt])
  @@index([groupId, userId, createdAt])
  @@index([userId, status, createdAt])
  @@map("ai_usage")
}

model AiAllowancePolicy {
  id            String                  @id @default(uuid()) @db.Uuid
  scopeType     AiScopeType             @map("scope_type")
  scopeKey      String                  @map("scope_key")
  businessId    String?                 @map("business_id") @db.Uuid
  groupId       String?                 @map("group_id") @db.Uuid
  effectiveFrom DateTime                @map("effective_from")
  effectiveTo   DateTime?               @map("effective_to")
  requestLimit  Int?                    @map("request_limit")
  tokenLimit    Int?                    @map("token_limit")
  timezone      String
  status        AiAllowancePolicyStatus
  source        AiAllowancePolicySource
  revision      Int
  reason        String
  createdById   String?                 @map("created_by_id") @db.Uuid
  createdAt     DateTime                @default(now()) @map("created_at")

  business     Business?            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  group        BusinessGroup?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy    User?                @relation("AiAllowancePolicyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  periods      AiAllowancePeriod[]
  reservations AiQuotaReservation[]
  events       AiUsageEvent[]

  @@unique([scopeKey, revision])
  @@index([scopeKey, effectiveFrom, effectiveTo, status])
  @@map("ai_allowance_policies")
}

model AiAllowancePeriod {
  id                   String      @id @default(uuid()) @db.Uuid
  scopeType            AiScopeType @map("scope_type")
  scopeKey             String      @map("scope_key")
  businessId           String?     @map("business_id") @db.Uuid
  groupId              String?     @map("group_id") @db.Uuid
  periodStart          DateTime    @map("period_start")
  periodEnd            DateTime    @map("period_end")
  timezone             String
  policyId             String      @map("policy_id") @db.Uuid
  policyRevision       Int         @map("policy_revision")
  requestLimitSnapshot Int?        @map("request_limit_snapshot")
  tokenLimitSnapshot   Int?        @map("token_limit_snapshot")
  reservedRequests     Int         @default(0) @map("reserved_requests")
  consumedRequests     Int         @default(0) @map("consumed_requests")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  business     Business?            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  group        BusinessGroup?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  policy       AiAllowancePolicy    @relation(fields: [policyId], references: [id], onDelete: Restrict)
  reservations AiQuotaReservation[]
  events       AiUsageEvent[]

  @@unique([scopeKey, periodStart])
  @@index([businessId, periodStart])
  @@index([groupId, periodStart])
  @@map("ai_allowance_periods")
}

model AiQuotaReservation {
  id             String                   @id @default(uuid()) @db.Uuid
  scopeType      AiScopeType              @map("scope_type")
  scopeKey       String                   @map("scope_key")
  businessId     String?                  @map("business_id") @db.Uuid
  groupId        String?                  @map("group_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  conversationId String?                  @map("conversation_id") @db.Uuid
  periodId       String                   @map("period_id") @db.Uuid
  policyId       String                   @map("policy_id") @db.Uuid
  policyRevision Int                      @map("policy_revision")
  requestKey     String                   @unique @map("request_key")
  status         AiQuotaReservationStatus @default(RESERVED)
  createdAt      DateTime                 @default(now()) @map("created_at")
  consumedAt     DateTime?                @map("consumed_at")
  releasedAt     DateTime?                @map("released_at")

  business     Business?         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  group        BusinessGroup?    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversation AiConversation?   @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  period       AiAllowancePeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  policy       AiAllowancePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  usage        AiUsage?
  events       AiUsageEvent[]

  @@index([scopeKey, status, createdAt])
  @@map("ai_quota_reservations")
}

model AiUsageEvent {
  id                  String           @id @default(uuid()) @db.Uuid
  eventType           AiUsageEventType @map("event_type")
  scopeType           AiScopeType      @map("scope_type")
  scopeKey            String           @map("scope_key")
  businessId          String?          @map("business_id") @db.Uuid
  groupId             String?          @map("group_id") @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  conversationId      String?          @map("conversation_id") @db.Uuid
  usageId             String?          @map("usage_id") @db.Uuid
  reservationId       String?          @map("reservation_id") @db.Uuid
  periodId            String?          @map("period_id") @db.Uuid
  policyId            String?          @map("policy_id") @db.Uuid
  policyRevision      Int?             @map("policy_revision")
  requestKey          String           @map("request_key")
  provider            String
  model               String
  providerRequestId   String?          @map("provider_request_id")
  inputTokens         Int?             @map("input_tokens")
  outputTokens        Int?             @map("output_tokens")
  totalTokens         Int?             @map("total_tokens")
  latencyMs           Int?             @map("latency_ms")
  promptVersion       String?          @map("prompt_version")
  contextVersion      String?          @map("context_version")
  commerciallyCounted Boolean          @default(false) @map("commercially_counted")
  errorCategory       String?          @map("error_category")
  createdAt           DateTime         @default(now()) @map("created_at")

  business     Business?           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  group        BusinessGroup?      @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversation AiConversation?     @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  usage        AiUsage?            @relation(fields: [usageId], references: [id], onDelete: Restrict)
  reservation  AiQuotaReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  period       AiAllowancePeriod?  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  policy       AiAllowancePolicy?  @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([scopeKey, createdAt])
  @@index([requestKey, createdAt])
  @@index([usageId])
  @@map("ai_usage_events")
}

// Group actions cannot use AuditLog alone because it requires businessId.
// This table retains platform-level group, membership, and access history.
model BusinessGroupAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  businessId  String?  @map("business_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  summary     String
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  group    BusinessGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  business Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actor    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([groupId, action, createdAt])
  @@map("business_group_audit_logs")
}

model StaffRoleProfile {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String
  permissions String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  users    User[]

  @@unique([businessId, name])
  @@index([businessId, active])
  @@map("staff_role_profiles")
}

model StaffLevel {
  id                 String   @id @default(uuid()) @db.Uuid
  businessId         String   @map("business_id") @db.Uuid
  name               String
  serviceFixedAmount Decimal  @default(0) @map("service_fixed_amount") @db.Decimal(10, 2)
  servicePercent     Decimal  @default(0) @map("service_percent") @db.Decimal(5, 2)
  productFixedAmount Decimal  @default(0) @map("product_fixed_amount") @db.Decimal(10, 2)
  productPercent     Decimal  @default(0) @map("product_percent") @db.Decimal(5, 2)
  packageFixedAmount Decimal  @default(0) @map("package_fixed_amount") @db.Decimal(10, 2)
