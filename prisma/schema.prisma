  payrollPaymentCommands         PayrollPaymentCommandRecord[]           @relation("PayrollPaymentCommandActor")
  payrollPaymentEvents           PayrollPaymentEvent[]                   @relation("PayrollPaymentEventActor")
  payrollPaymentArtifactsCreated PayrollPaymentArtifact[]                @relation("PayrollPaymentArtifactCreatedBy")
  claimPayrollSnapshotsCreated   PayrollClaimReimbursementSnapshot[]     @relation("ClaimPayrollSnapshotCreatedBy")
  commissionRulesCreated         CommissionRule[]                        @relation("CommissionRuleCreatedBy")
