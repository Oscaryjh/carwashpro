model BusinessModuleEntitlement {
  id           String                          @id @default(uuid()) @db.Uuid
  businessId   String                          @map("business_id") @db.Uuid
  moduleKey    BusinessModuleKey               @map("module_key")
  status       BusinessModuleEntitlementStatus
  enabledFrom  DateTime                        @map("enabled_from")
  enabledUntil DateTime?                       @map("enabled_until")
  source       BusinessModuleEntitlementSource
  planCode     String?                         @map("plan_code")
  revision     Int                             @default(1)
  createdById  String?                         @map("created_by_id") @db.Uuid
  updatedById  String?                         @map("updated_by_id") @db.Uuid
  createdAt    DateTime                        @default(now()) @map("created_at")
  updatedAt    DateTime                        @updatedAt @map("updated_at")

  business Business                         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  events   BusinessModuleEntitlementEvent[]

  @@unique([businessId, moduleKey])
  @@unique([id, businessId])
  @@index([businessId, status, enabledFrom, enabledUntil])
  @@map("business_module_entitlements")
}

model BusinessModuleEntitlementEvent {
  id              String                           @id @default(uuid()) @db.Uuid
  entitlementId   String                           @map("entitlement_id") @db.Uuid
  businessId      String                           @map("business_id") @db.Uuid
  moduleKey       BusinessModuleKey                @map("module_key")
  revision        Int
  oldStatus       BusinessModuleEntitlementStatus? @map("old_status")
  newStatus       BusinessModuleEntitlementStatus  @map("new_status")
  oldEnabledFrom  DateTime?                        @map("old_enabled_from")
  newEnabledFrom  DateTime                         @map("new_enabled_from")
  oldEnabledUntil DateTime?                        @map("old_enabled_until")
  newEnabledUntil DateTime?                        @map("new_enabled_until")
  source          BusinessModuleEntitlementSource
  planCode        String?                          @map("plan_code")
  reason          String
  actorUserId     String?                          @map("actor_user_id") @db.Uuid
  createdAt       DateTime                         @default(now()) @map("created_at")

  entitlement BusinessModuleEntitlement @relation(fields: [entitlementId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([entitlementId, revision])
  @@index([businessId, moduleKey, createdAt])
  @@map("business_module_entitlement_events")
}

model CommercialPlan {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique
  displayName String              @map("display_name")
  description String?
  scopeType   CommercialScopeType @map("scope_type")
  planType    CommercialPlanType  @map("plan_type")
  active      Boolean             @default(true)
  createdById String              @map("created_by_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  createdBy User                    @relation("CommercialPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions  CommercialPlanVersion[]

  @@index([scopeType, planType, active])
  @@map("commercial_plans")
}

model CommercialPlanVersion {
  id                          String                      @id @default(uuid()) @db.Uuid
  planId                      String                      @map("plan_id") @db.Uuid
  version                     Int
  currency                    String                      @default("MYR")
  monthlyListPriceCents       Int?                        @map("monthly_list_price_cents")
  annualListPriceCents        Int?                        @map("annual_list_price_cents")
  setupFeeCents               Int?                        @map("setup_fee_cents")
  includedBranches            Int?                        @map("included_branches")
  includedEmployees           Int?                        @map("included_employees")
  extraBranchUnitPriceCents   Int?                        @map("extra_branch_unit_price_cents")
  extraEmployeeUnitPriceCents Int?                        @map("extra_employee_unit_price_cents")
  businessAiAllowance         Int?                        @map("business_ai_allowance")
  groupAiAllowance            Int?                        @map("group_ai_allowance")
  effectiveFrom               DateTime                    @map("effective_from")
  effectiveTo                 DateTime?                   @map("effective_to")
  status                      CommercialPlanVersionStatus @default(DRAFT)
  revision                    Int                         @default(1)
  createdById                 String                      @map("created_by_id") @db.Uuid
  activatedById               String?                     @map("activated_by_id") @db.Uuid
  activatedAt                 DateTime?                   @map("activated_at")
  createdAt                   DateTime                    @default(now()) @map("created_at")
  updatedAt                   DateTime                    @updatedAt @map("updated_at")

  plan                 CommercialPlan                   @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy            User                             @relation("CommercialPlanVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  activatedBy          User?                            @relation("CommercialPlanVersionActivator", fields: [activatedById], references: [id], onDelete: Restrict)
  modules              CommercialPlanVersionModule[]
