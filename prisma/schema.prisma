  branch               Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  dailyClosingSnapshot DailyClosingSnapshot?     @relation(fields: [dailyClosingSnapshotId], references: [id], onDelete: SetNull)
  recipient            ClosingWhatsAppRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  queue                NotificationQueue?        @relation(fields: [queueId], references: [id], onDelete: SetNull)
  messageLog           WhatsAppMessage?          @relation(fields: [messageLogId], references: [id], onDelete: SetNull)
  requestedBy          User?                     @relation("ClosingWhatsAppRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([branchId])
  @@index([dailyClosingSnapshotId])
  @@index([queueId])
  @@index([messageLogId])
  @@index([requestedByUserId])
  @@index([sendType, status])
  @@map("closing_whatsapp_send_attempts")
}

model Invoice {
  id                    String        @id @default(uuid()) @db.Uuid
  businessId            String        @map("business_id") @db.Uuid
  branchId              String?       @map("branch_id") @db.Uuid
  workOrderId           String?       @unique @map("work_order_id") @db.Uuid
  appointmentId         String?       @unique @map("appointment_id") @db.Uuid
  customerId            String?       @map("customer_id") @db.Uuid
  customerPackageId     String?       @unique @map("customer_package_id") @db.Uuid
  invoiceNumber         String        @map("invoice_number")
  subtotal              Decimal       @db.Decimal(10, 2)
  discountAmount        Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  discountReason        String?       @map("discount_reason")
  loyaltyPointsRedeemed Int           @default(0) @map("loyalty_points_redeemed")
  loyaltyDiscountAmount Decimal       @default(0) @map("loyalty_discount_amount") @db.Decimal(10, 2)
  depositAmount         Decimal       @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  tipAmount             Decimal       @default(0) @map("tip_amount") @db.Decimal(10, 2)
  taxableSubtotal       Decimal       @default(0) @map("taxable_subtotal") @db.Decimal(10, 2)
  taxAmount             Decimal       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  taxRate               Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxLabel              String?       @map("tax_label")
  total                 Decimal       @db.Decimal(10, 2)
  paidAmount            Decimal       @map("paid_amount") @db.Decimal(10, 2)
  balance               Decimal       @db.Decimal(10, 2)
  status                InvoiceStatus @default(UNPAID)
  issuedAt              DateTime      @default(now()) @map("issued_at")
  voidedAt              DateTime?     @map("voided_at")
  voidReason            String?       @map("void_reason")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  workOrder        WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  appointment      Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerPackage  CustomerPackage?  @relation(fields: [customerPackageId], references: [id], onDelete: Restrict)
  whatsappMessages WhatsAppMessage[]
  refunds          PaymentRefund[]
  payments         Payment[]
  items            InvoiceItem[]
  creditNotes      CreditNote[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([businessId, issuedAt, status], map: "invoices_business_issued_status_idx")
  @@index([businessId, updatedAt], map: "invoices_business_updated_idx")
  @@index([branchId])
  @@index([customerId])
  @@index([appointmentId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  invoiceId         String   @map("invoice_id") @db.Uuid
  serviceId         String?  @map("service_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  customerPackageId String?  @map("customer_package_id") @db.Uuid
  name              String
  quantity          Int      @default(1)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(10, 2)
  lineTotal         Decimal  @map("line_total") @db.Decimal(10, 2)
  taxable           Boolean  @default(false)
  taxRate           Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount         Decimal  @default(0) @map("tax_amount") @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service         Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerPackage CustomerPackage? @relation(fields: [customerPackageId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([invoiceId])
  @@index([serviceId])
  @@index([productId])
  @@index([customerPackageId])
  @@map("invoice_items")
}

model WhatsAppMessage {
