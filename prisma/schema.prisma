model ServiceCategory {
  id         String                @id @default(uuid()) @db.Uuid
  businessId String                @map("business_id") @db.Uuid
  name       String
  status     ServiceCategoryStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  services Service[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([status])
  @@map("service_categories")
}

model Service {
  id              String        @id @default(uuid()) @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  branchId        String?       @map("branch_id") @db.Uuid
  categoryId      String?       @map("category_id") @db.Uuid
  name            String
  category        String?
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  durationMinutes Int?          @map("duration_minutes")
  taxable         Boolean       @default(true)
  taxRate         Decimal?      @map("tax_rate") @db.Decimal(5, 2)
  status          ServiceStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  business         Business                        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch           Branch?                         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  serviceCategory  ServiceCategory?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items            WorkOrderItem[]
  packages         Package[]
  packageBenefits  PackageServiceBenefit[]
  packageBalances  CustomerPackageServiceBalance[]
  appointments     Appointment[]
  staffAssignments ServiceStaffAssignment[]
  invoiceItems     InvoiceItem[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, category])
  @@index([branchId])
  @@index([categoryId])
  @@map("services")
}

model ServiceStaffAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("service_staff_assignments")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  businessId  String        @map("business_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  name        String
  sku         String?
  description String?
  category    String?
  price       Decimal       @db.Decimal(10, 2)
  costPrice   Decimal?      @map("cost_price") @db.Decimal(10, 2)
  taxable     Boolean       @default(false)
  taxRate     Decimal?      @map("tax_rate") @db.Decimal(5, 2)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productCategory ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stocks          ProductStock[]
  invoiceItems    InvoiceItem[]

  @@unique([businessId, name])
  @@index([businessId, status])
  @@index([businessId, category])
  @@index([categoryId])
  @@map("products")
}

model ProductCategory {
  id         String                @id @default(uuid()) @db.Uuid
  businessId String                @map("business_id") @db.Uuid
  name       String
  status     ProductCategoryStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([status])
  @@map("product_categories")
}

model ProductStock {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  quantity     Int      @default(0)
  reorderLevel Int      @default(0) @map("reorder_level")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([businessId, branchId])
  @@index([productId])
  @@map("product_stocks")
}

model StaffAvailability {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week")
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId, dayOfWeek])
  @@index([businessId, userId])
  @@map("staff_availability")
}

model StaffBreak {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week")
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  label      String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, userId, dayOfWeek])
  @@map("staff_breaks")
}

model StaffTimeOff {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  leaveRequestId String?  @unique @map("leave_request_id") @db.Uuid
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@index([businessId, userId, startsAt])
  @@map("staff_time_off")
}

model LeavePolicy {
  id                     String            @id @default(uuid()) @db.Uuid
  businessId             String            @map("business_id") @db.Uuid
  code                   LeavePolicyCode
  name                   String
  payTreatment           LeavePayTreatment @default(PAID) @map("pay_treatment")
  countMode              LeaveCountMode    @default(WEEKDAYS) @map("count_mode")
  balanceTracked         Boolean           @default(true) @map("balance_tracked")
  defaultEntitlementDays Decimal?          @map("default_entitlement_days") @db.Decimal(6, 2)
  underTwoYearsDays      Decimal?          @map("under_two_years_days") @db.Decimal(6, 2)
  twoToFiveYearsDays     Decimal?          @map("two_to_five_years_days") @db.Decimal(6, 2)
  fiveYearsPlusDays      Decimal?          @map("five_years_plus_days") @db.Decimal(6, 2)
  requiresDocument       Boolean           @default(false) @map("requires_document")
  allowNegativeBalance   Boolean           @default(false) @map("allow_negative_balance")
  active                 Boolean           @default(true)
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  business Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  balances EmployeeLeaveBalance[]
  requests LeaveRequest[]

  @@unique([businessId, code])
  @@index([businessId, active, name])
  @@map("leave_policies")
}

model EmployeeLeaveBalance {
  id                      String   @id @default(uuid()) @db.Uuid
  businessId              String   @map("business_id") @db.Uuid
  membershipId            String   @map("membership_id") @db.Uuid
  policyId                String   @map("policy_id") @db.Uuid
  year                    Int
  entitlementOverrideDays Decimal? @map("entitlement_override_days") @db.Decimal(6, 2)
  carriedForwardDays      Decimal  @default(0) @map("carried_forward_days") @db.Decimal(6, 2)
  adjustmentDays          Decimal  @default(0) @map("adjustment_days") @db.Decimal(6, 2)
  note                    String?
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  business   Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  membership EmployeeBusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  policy     LeavePolicy                @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([membershipId, policyId, year])
  @@index([businessId, year, policyId])
  @@map("employee_leave_balances")
}

model LeaveRequest {
  id                   String             @id @default(uuid()) @db.Uuid
  businessId           String             @map("business_id") @db.Uuid
  membershipId         String             @map("membership_id") @db.Uuid
  branchId             String             @map("branch_id") @db.Uuid
  policyId             String             @map("policy_id") @db.Uuid
  policyNameSnapshot   String             @map("policy_name_snapshot")
  payTreatmentSnapshot LeavePayTreatment  @map("pay_treatment_snapshot")
  startsOn             DateTime           @map("starts_on") @db.Date
  endsOn               DateTime           @map("ends_on") @db.Date
  requestedDays        Decimal            @map("requested_days") @db.Decimal(6, 2)
  reason               String
  documentReference    String?            @map("document_reference")
  status               LeaveRequestStatus @default(PENDING)
  reviewedById         String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt           DateTime?          @map("reviewed_at")
  reviewNote           String?            @map("review_note")
  cancelledAt          DateTime?          @map("cancelled_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  business     Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  membership   EmployeeBusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  branch       Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  policy       LeavePolicy                @relation(fields: [policyId], references: [id], onDelete: Restrict)
  reviewedBy   User?                      @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  days         LeaveRequestDay[]
  staffTimeOff StaffTimeOff?

  @@index([businessId, branchId, status, startsOn])
  @@index([membershipId, status, startsOn])
  @@index([policyId, status, startsOn])
  @@map("leave_requests")
}

model LeaveRequestDay {
  id             String   @id @default(uuid()) @db.Uuid
  leaveRequestId String   @map("leave_request_id") @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  leaveDate      DateTime @map("leave_date") @db.Date
  dayFraction    Decimal  @default(1) @map("day_fraction") @db.Decimal(3, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  leaveRequest LeaveRequest               @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  business     Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  membership   EmployeeBusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@unique([leaveRequestId, leaveDate])
  @@index([businessId, leaveDate])
  @@index([membershipId, leaveDate])
  @@map("leave_request_days")
}

model Package {
  id                  String             @id @default(uuid()) @db.Uuid
  businessId          String             @map("business_id") @db.Uuid
  branchId            String?            @map("branch_id") @db.Uuid
  categoryId          String?            @map("category_id") @db.Uuid
  serviceId           String?            @map("service_id") @db.Uuid
  name                String
  description         String?
  price               Decimal            @db.Decimal(10, 2)
  totalUses           Int                @default(10) @map("total_uses")
  eligibleVehicleSize PackageVehicleSize @default(ALL) @map("eligible_vehicle_size")
  status              PackageStatus      @default(ACTIVE)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  business         Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch           Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  packageCategory  PackageCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  service          Service?                @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customerPackages CustomerPackage[]
  serviceBenefits  PackageServiceBenefit[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([branchId])
  @@index([categoryId])
  @@index([serviceId])
  @@index([status])
  @@map("packages")
}

model PackageCategory {
  id         String                @id @default(uuid()) @db.Uuid
  businessId String                @map("business_id") @db.Uuid
  name       String
  status     PackageCategoryStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  packages Package[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([status])
  @@map("package_categories")
}

model PackageServiceBenefit {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  packageId  String   @map("package_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  totalUses  Int      @map("total_uses")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  package  Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([packageId, serviceId])
  @@index([businessId])
  @@index([serviceId])
  @@map("package_service_benefits")
}

model CatalogDiscount {
  id                   String               @id @default(uuid()) @db.Uuid
  businessId           String               @map("business_id") @db.Uuid
  branchId             String?              @map("branch_id") @db.Uuid
  name                 String
  discountType         CatalogDiscountType  @default(PERCENTAGE) @map("discount_type")
  percentage           Decimal?             @db.Decimal(5, 2)
  fixedAmount          Decimal?             @map("fixed_amount") @db.Decimal(10, 2)
  scope                CatalogDiscountScope @default(ALL)
  minimumSpend         Decimal              @default(0) @map("minimum_spend") @db.Decimal(10, 2)
  maximumDiscount      Decimal?             @map("maximum_discount") @db.Decimal(10, 2)
  allowLoyaltyStacking Boolean              @default(false) @map("allow_loyalty_stacking")
  startsAt             DateTime?            @map("starts_at")
  endsAt               DateTime?            @map("ends_at")
  active               Boolean              @default(true)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([businessId, name])
  @@index([businessId, active])
  @@index([branchId])
  @@index([startsAt, endsAt])
  @@map("catalog_discounts")
}

model CustomerPackage {
  id                  String                @id @default(uuid()) @db.Uuid
  businessId          String                @map("business_id") @db.Uuid
  branchId            String?               @map("branch_id") @db.Uuid
  customerId          String                @map("customer_id") @db.Uuid
  packageId           String                @map("package_id") @db.Uuid
  purchasePrice       Decimal               @map("purchase_price") @db.Decimal(10, 2)
  totalUses           Int                   @map("total_uses")
  remainingUses       Int                   @map("remaining_uses")
  eligibleVehicleSize PackageVehicleSize    @default(ALL) @map("eligible_vehicle_size")
  status              CustomerPackageStatus @default(PENDING_PAYMENT)
  purchasedAt         DateTime              @default(now()) @map("purchased_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  business        Business                        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch          Branch?                         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer        Customer                        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package         Package                         @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payments        Payment[]
  invoice         Invoice?
  invoiceItems    InvoiceItem[]
  serviceBalances CustomerPackageServiceBalance[]

  @@index([businessId])
  @@index([branchId])
  @@index([customerId])
  @@index([packageId])
  @@index([status])
  @@map("customer_packages")
}

model CustomerPackageServiceBalance {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  customerPackageId String   @map("customer_package_id") @db.Uuid
  serviceId         String   @map("service_id") @db.Uuid
  totalUses         Int      @map("total_uses")
  remainingUses     Int      @map("remaining_uses")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customerPackage CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  payments        Payment[]

  @@unique([customerPackageId, serviceId])
  @@index([businessId])
  @@index([serviceId])
  @@map("customer_package_service_balances")
}

model WorkOrder {
  id            String               @id @default(uuid()) @db.Uuid
  businessId    String               @map("business_id") @db.Uuid
  branchId      String?              @map("branch_id") @db.Uuid
  customerId    String               @map("customer_id") @db.Uuid
  vehicleId     String               @map("vehicle_id") @db.Uuid
  orderNumber   String               @map("order_number")
  status        WorkOrderStatus      @default(WAITING)
  contactName   String?              @map("contact_name")
  contactPhone  String?              @map("contact_phone")
  contactType   WorkOrderContactType @default(REGISTERED_OWNER) @map("contact_type")
  subtotal      Decimal              @db.Decimal(10, 2)
  total         Decimal              @db.Decimal(10, 2)
  paidAmount    Decimal              @default(0) @map("paid_amount") @db.Decimal(10, 2)
  balance       Decimal              @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus        @default(UNPAID) @map("payment_status")
  pickedUpAt    DateTime?            @map("picked_up_at")
  notes         String?
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  items            WorkOrderItem[]
  payments         Payment[]
  paymentRefunds   PaymentRefund[]
  invoice          Invoice?
  whatsappMessages WhatsAppMessage[]
  appointment      Appointment?

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([paymentStatus])
  @@map("work_orders")
}

model Appointment {
  id              String               @id @default(uuid()) @db.Uuid
  businessId      String               @map("business_id") @db.Uuid
  branchId        String?              @map("branch_id") @db.Uuid
  customerId      String               @map("customer_id") @db.Uuid
  vehicleId       String?              @map("vehicle_id") @db.Uuid
  serviceId       String?              @map("service_id") @db.Uuid
  serviceIds      String[]             @default([]) @map("service_ids")
  productIds      String[]             @default([]) @map("product_ids")
  packageIds      String[]             @default([]) @map("package_ids")
  workOrderId     String?              @unique @map("work_order_id") @db.Uuid
  createdById     String?              @map("created_by_id") @db.Uuid
  assignedStaffId String?              @map("assigned_staff_id") @db.Uuid
  contactType     WorkOrderContactType @default(REGISTERED_OWNER) @map("contact_type")
  contactName     String?              @map("contact_name")
  contactPhone    String?              @map("contact_phone")
  scheduledAt     DateTime             @map("scheduled_at")
  durationMinutes Int                  @default(15) @map("duration_minutes")
  status          AppointmentStatus    @default(SCHEDULED)
  notes           String?
  confirmedAt     DateTime?            @map("confirmed_at")
  arrivedAt       DateTime?            @map("arrived_at")
  startedAt       DateTime?            @map("started_at")
  completedAt     DateTime?            @map("completed_at")
  convertedAt     DateTime?            @map("converted_at")
  cancelledAt     DateTime?            @map("cancelled_at")
  noShowAt        DateTime?            @map("no_show_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle            Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  service            Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  workOrder          WorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  createdBy          User?               @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedStaff      User?               @relation("AppointmentAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  whatsappMessages   WhatsAppMessage[]
  notificationQueues NotificationQueue[]
  invoice            Invoice?
  payments           Payment[]

  @@index([businessId])
  @@index([branchId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([serviceId])
  @@index([createdById])
  @@index([assignedStaffId])
  @@index([businessId, assignedStaffId, scheduledAt])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

model AppointmentReminderSetting {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @unique @map("business_id") @db.Uuid
  enabled         Boolean  @default(true)
  leadTimeMinutes Int      @default(1440) @map("lead_time_minutes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("appointment_reminder_settings")
}

model VehicleOwnershipHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  businessId         String   @map("business_id") @db.Uuid
  branchId           String?  @map("branch_id") @db.Uuid
  vehicleId          String   @map("vehicle_id") @db.Uuid
  previousCustomerId String?  @map("previous_customer_id") @db.Uuid
  newCustomerId      String   @map("new_customer_id") @db.Uuid
  transferredAt      DateTime @default(now()) @map("transferred_at")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")

