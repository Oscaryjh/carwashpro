  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor    User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([businessId, actorUserId, createdAt])
  @@index([businessId, action, createdAt])
  @@index([businessId, entityType, entityId])
  @@map("audit_logs")
}

model NotificationQueue {
  id                String                    @id @default(uuid()) @db.Uuid
  businessId        String                    @map("business_id") @db.Uuid
  branchId          String?                   @map("branch_id") @db.Uuid
  phone             String
  message           String
  messageType       String                    @map("message_type")
  documentBase64    String?                   @map("document_base64")
  documentMimeType  String?                   @map("document_mime_type")
  documentFileName  String?                   @map("document_file_name")
  priority          NotificationQueuePriority @default(NORMAL)
  status            NotificationQueueStatus   @default(QUEUED)
  retryCount        Int                       @default(0) @map("retry_count")
  messageLogId      String?                   @map("message_log_id") @db.Uuid
  appointmentId     String?                   @map("appointment_id") @db.Uuid
  dailyClosingSnapshotId String?              @map("daily_closing_snapshot_id") @db.Uuid
  dedupeKey         String?                   @unique @map("dedupe_key")
  providerMessageId String?                   @map("provider_message_id")
  errorMessage      String?                   @map("error_message")
  createdAt         DateTime                  @default(now()) @map("created_at")
  queuedAt          DateTime                  @default(now()) @map("queued_at")
  nextAttemptAt     DateTime?                 @map("next_attempt_at")
  sentAt            DateTime?                 @map("sent_at")
  deliveredAt       DateTime?                 @map("delivered_at")
  readAt            DateTime?                 @map("read_at")
  failedAt          DateTime?                 @map("failed_at")

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch      Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  messageLog  WhatsAppMessage? @relation(fields: [messageLogId], references: [id], onDelete: SetNull)
  appointment Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  dailyClosingSnapshot DailyClosingSnapshot? @relation(fields: [dailyClosingSnapshotId], references: [id], onDelete: SetNull)
  closingWhatsAppSends ClosingWhatsAppSendAttempt[]

  @@index([businessId])
  @@index([branchId])
  @@index([messageLogId])
  @@index([appointmentId])
  @@index([dailyClosingSnapshotId])
  @@index([providerMessageId])
  @@index([status])
  @@index([status, priority, queuedAt])
  @@index([status, nextAttemptAt])
  @@map("notification_queue")
}
