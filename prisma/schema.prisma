model ServiceCategory {
  id         String                @id @default(uuid()) @db.Uuid
  businessId String                @map("business_id") @db.Uuid
  name       String
  status     ServiceCategoryStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  services Service[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([status])
  @@map("service_categories")
}

model Service {
  id              String        @id @default(uuid()) @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  branchId        String?       @map("branch_id") @db.Uuid
  categoryId      String?       @map("category_id") @db.Uuid
  name            String
  category        String?
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  durationMinutes Int?          @map("duration_minutes")
  taxable         Boolean       @default(true)
  taxRate         Decimal?      @map("tax_rate") @db.Decimal(5, 2)
  status          ServiceStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  business         Business                        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch           Branch?                         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  serviceCategory  ServiceCategory?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items            WorkOrderItem[]
  packages         Package[]
  packageBenefits  PackageServiceBenefit[]
  packageBalances  CustomerPackageServiceBalance[]
  appointments     Appointment[]
  staffAssignments ServiceStaffAssignment[]
  invoiceItems     InvoiceItem[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, category])
  @@index([branchId])
  @@index([categoryId])
  @@map("services")
}

model ServiceStaffAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("service_staff_assignments")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  businessId     String        @map("business_id") @db.Uuid
  categoryId     String?       @map("category_id") @db.Uuid
  name           String
  sku            String?
  description    String?
  category       String?
  price          Decimal       @db.Decimal(10, 2)
  costPrice      Decimal?      @map("cost_price") @db.Decimal(10, 2)
  taxable        Boolean       @default(false)
  taxRate        Decimal?      @map("tax_rate") @db.Decimal(5, 2)
  trackInventory Boolean       @default(false) @map("track_inventory")
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  business                Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productCategory         ProductCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stocks                  ProductStock[]
  invoiceItems            InvoiceItem[]
  inventoryMovements      InventoryMovement[]
  inventoryTransfers      InventoryTransfer[]
  inventoryRefundLines    InventoryRefundLine[]
  purchaseOrderLines      PurchaseOrderLine[]
  goodsReceiptLines       GoodsReceiptLine[]
  supplierBillLines       SupplierBillLine[]
  goodsReceiptReversals   GoodsReceiptReversal[]
  stockCountLines         StockCountLine[]
  stockCountLineRevisions StockCountLineRevision[]

  @@unique([businessId, name])
  @@unique([id, businessId])
  @@unique([businessId, sku])
  @@index([businessId, status])
  @@index([businessId, category])
  @@index([categoryId])
  @@map("products")
}

model ProductCategory {
  id         String                @id @default(uuid()) @db.Uuid
  businessId String                @map("business_id") @db.Uuid
  name       String
  status     ProductCategoryStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([status])
  @@map("product_categories")
}

model ProductStock {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String   @map("business_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  quantity         Int      @default(0)
  reorderLevel     Int      @default(0) @map("reorder_level")
  targetStockLevel Int?     @map("target_stock_level")
  revision         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch   Branch   @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  product  Product  @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([branchId, productId])
  @@index([businessId, branchId])
  @@index([productId])
  @@map("product_stocks")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  businessId     String                @map("business_id") @db.Uuid
  branchId       String                @map("branch_id") @db.Uuid
  productId      String                @map("product_id") @db.Uuid
  transferId     String?               @map("transfer_id") @db.Uuid
  actorUserId    String?               @map("actor_user_id") @db.Uuid
  type           InventoryMovementType
  quantityDelta  Int                   @map("quantity_delta")
  quantityBefore Int                   @map("quantity_before")
  quantityAfter  Int                   @map("quantity_after")
  sourceType     String                @map("source_type") @db.VarChar(50)
  sourceId       String                @map("source_id") @db.VarChar(160)
  sourceLineId   String?               @map("source_line_id") @db.Uuid
  operationKey   String                @map("operation_key") @db.VarChar(180)
  reason         String
  reference      String?
  createdAt      DateTime              @default(now()) @map("created_at")

  business Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch   Branch             @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  product  Product            @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)
  transfer InventoryTransfer? @relation(fields: [transferId, businessId], references: [id, businessId], onDelete: Restrict)
  actor    User?              @relation("InventoryMovementActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([businessId, operationKey])
  @@index([businessId, branchId, productId, createdAt])
  @@index([businessId, type, createdAt])
  @@index([businessId, sourceType, sourceId])
  @@index([transferId])
  @@map("inventory_movements")
}

model InventoryTransfer {
  id                  String                  @id @default(uuid()) @db.Uuid
  businessId          String                  @map("business_id") @db.Uuid
  sourceBranchId      String                  @map("source_branch_id") @db.Uuid
  destinationBranchId String                  @map("destination_branch_id") @db.Uuid
  productId           String                  @map("product_id") @db.Uuid
  actorUserId         String?                 @map("actor_user_id") @db.Uuid
  quantity            Int
  status              InventoryTransferStatus @default(COMPLETED)
  operationKey        String                  @map("operation_key") @db.VarChar(160)
  reason              String
  reference           String?
  completedAt         DateTime                @default(now()) @map("completed_at")
  createdAt           DateTime                @default(now()) @map("created_at")

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sourceBranch      Branch              @relation("InventoryTransferSourceBranch", fields: [sourceBranchId, businessId], references: [id, businessId], onDelete: Restrict)
  destinationBranch Branch              @relation("InventoryTransferDestinationBranch", fields: [destinationBranchId, businessId], references: [id, businessId], onDelete: Restrict)
  product           Product             @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)
  actor             User?               @relation("InventoryTransferActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  movements         InventoryMovement[]

  @@unique([id, businessId])
  @@unique([businessId, operationKey])
  @@index([businessId, completedAt])
  @@index([sourceBranchId])
  @@index([destinationBranchId])
  @@map("inventory_transfers")
}

model InventoryRefundLine {
  id              String                     @id @default(uuid()) @db.Uuid
  businessId      String                     @map("business_id") @db.Uuid
  branchId        String                     @map("branch_id") @db.Uuid
  paymentRefundId String                     @map("payment_refund_id") @db.Uuid
  invoiceItemId   String                     @map("invoice_item_id") @db.Uuid
  productId       String                     @map("product_id") @db.Uuid
  actorUserId     String?                    @map("actor_user_id") @db.Uuid
  quantity        Int
  disposition     InventoryRefundDisposition
  noRestockReason String?                    @map("no_restock_reason")
  createdAt       DateTime                   @default(now()) @map("created_at")

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch        Branch        @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  paymentRefund PaymentRefund @relation(fields: [paymentRefundId, businessId], references: [id, businessId], onDelete: Restrict)
  invoiceItem   InvoiceItem   @relation(fields: [invoiceItemId, businessId], references: [id, businessId], onDelete: Restrict)
  product       Product       @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)
  actor         User?         @relation("InventoryRefundLineActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([paymentRefundId, invoiceItemId])
  @@index([businessId, branchId, productId])
  @@index([invoiceItemId])
  @@map("inventory_refund_lines")
}

model Supplier {
  id            String         @id @default(uuid()) @db.Uuid
  businessId    String         @map("business_id") @db.Uuid
  code          String?        @db.VarChar(40)
  name          String         @db.VarChar(160)
  contactPerson String?        @map("contact_person") @db.VarChar(120)
  phone         String?        @db.VarChar(40)
  email         String?        @db.VarChar(160)
  address       String?
  notes         String?
  status        SupplierStatus @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  supplierBills    SupplierBill[]
  supplierPayments SupplierPayment[]

  @@unique([id, businessId])
  @@unique([businessId, code])
  @@index([businessId, status, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @map("business_id") @db.Uuid
  branchId           String              @map("branch_id") @db.Uuid
  supplierId         String              @map("supplier_id") @db.Uuid
  poNumber           String              @map("po_number") @db.VarChar(40)
  status             PurchaseOrderStatus @default(DRAFT)
  orderDate          DateTime            @map("order_date") @db.Date
  expectedDate       DateTime?           @map("expected_date") @db.Date
  currency           String              @default("MYR") @db.VarChar(3)
  subtotal           Decimal             @default(0) @db.Decimal(12, 2)
  notes              String?
  revision           Int                 @default(0)
  createdById        String              @map("created_by_id") @db.Uuid
  approvedById       String?             @map("approved_by_id") @db.Uuid
  approvedAt         DateTime?           @map("approved_at")
  cancelledById      String?             @map("cancelled_by_id") @db.Uuid
  cancelledAt        DateTime?           @map("cancelled_at")
  cancellationReason String?             @map("cancellation_reason")
  closedById         String?             @map("closed_by_id") @db.Uuid
  closedAt           DateTime?           @map("closed_at")
  closeReason        String?             @map("close_reason")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  business      Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch        Branch                 @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  supplier      Supplier               @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy     User                   @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy    User?                  @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  cancelledBy   User?                  @relation("PurchaseOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  closedBy      User?                  @relation("PurchaseOrderClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  lines         PurchaseOrderLine[]
  receipts      GoodsReceipt[]
  reversals     GoodsReceiptReversal[]
  supplierBills SupplierBill[]

  @@unique([id, businessId])
  @@unique([businessId, poNumber])
  @@index([businessId, status, orderDate])
  @@index([businessId, branchId, status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String   @map("business_id") @db.Uuid
  purchaseOrderId  String   @map("purchase_order_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  orderedQuantity  Int      @map("ordered_quantity")
  receivedQuantity Int      @default(0) @map("received_quantity")
  expectedUnitCost Decimal  @map("expected_unit_cost") @db.Decimal(12, 2)
  expectedTotal    Decimal  @map("expected_total") @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  business          Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  purchaseOrder     PurchaseOrder          @relation(fields: [purchaseOrderId, businessId], references: [id, businessId], onDelete: Restrict)
  product           Product                @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)
  receiptLines      GoodsReceiptLine[]
  reversals         GoodsReceiptReversal[]
  supplierBillLines SupplierBillLine[]

  @@unique([id, businessId])
  @@unique([purchaseOrderId, productId])
  @@index([businessId, productId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id                String             @id @default(uuid()) @db.Uuid
  businessId        String             @map("business_id") @db.Uuid
  branchId          String             @map("branch_id") @db.Uuid
  supplierId        String             @map("supplier_id") @db.Uuid
  purchaseOrderId   String             @map("purchase_order_id") @db.Uuid
  receiptNumber     String             @map("receipt_number") @db.VarChar(40)
  status            GoodsReceiptStatus @default(RECEIVED)
  deliveryReference String?            @map("delivery_reference") @db.VarChar(120)
  notes             String?
  receivedAt        DateTime           @default(now()) @map("received_at")
  receivedById      String             @map("received_by_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")

  business      Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch        Branch                 @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  supplier      Supplier               @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Restrict)
  purchaseOrder PurchaseOrder          @relation(fields: [purchaseOrderId, businessId], references: [id, businessId], onDelete: Restrict)
  receivedBy    User                   @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  lines         GoodsReceiptLine[]
  reversals     GoodsReceiptReversal[]

  @@unique([id, businessId])
  @@unique([businessId, receiptNumber])
  @@index([businessId, purchaseOrderId, receivedAt])
  @@index([businessId, branchId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                      String   @id @default(uuid()) @db.Uuid
  businessId              String   @map("business_id") @db.Uuid
  goodsReceiptId          String   @map("goods_receipt_id") @db.Uuid
  purchaseOrderLineId     String   @map("purchase_order_line_id") @db.Uuid
  productId               String   @map("product_id") @db.Uuid
  receivedQuantity        Int      @map("received_quantity")
  unitCostSnapshot        Decimal  @map("unit_cost_snapshot") @db.Decimal(12, 2)
  orderedQuantitySnapshot Int      @map("ordered_quantity_snapshot")
  previouslyReceived      Int      @map("previously_received")
  remainingAfterReceipt   Int      @map("remaining_after_receipt")
  createdAt               DateTime @default(now()) @map("created_at")

  business          Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  goodsReceipt      GoodsReceipt           @relation(fields: [goodsReceiptId, businessId], references: [id, businessId], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine      @relation(fields: [purchaseOrderLineId, businessId], references: [id, businessId], onDelete: Restrict)
  product           Product                @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)
  reversals         GoodsReceiptReversal[]

  @@unique([id, businessId])
  @@unique([goodsReceiptId, purchaseOrderLineId])
  @@index([businessId, productId])
  @@map("goods_receipt_lines")
}

model GoodsReceiptReversal {
  id                  String   @id @default(uuid()) @db.Uuid
  businessId          String   @map("business_id") @db.Uuid
  branchId            String   @map("branch_id") @db.Uuid
  goodsReceiptId      String   @map("goods_receipt_id") @db.Uuid
  goodsReceiptLineId  String   @map("goods_receipt_line_id") @db.Uuid
  purchaseOrderId     String   @map("purchase_order_id") @db.Uuid
  purchaseOrderLineId String   @map("purchase_order_line_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  reversedQuantity    Int      @map("reversed_quantity")
  reason              String
  createdById         String   @map("created_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  business          Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch            Branch            @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId, businessId], references: [id, businessId], onDelete: Restrict)
  goodsReceiptLine  GoodsReceiptLine  @relation(fields: [goodsReceiptLineId, businessId], references: [id, businessId], onDelete: Restrict)
  purchaseOrder     PurchaseOrder     @relation(fields: [purchaseOrderId, businessId], references: [id, businessId], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId, businessId], references: [id, businessId], onDelete: Restrict)
  product           Product           @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy         User              @relation("GoodsReceiptReversalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([id, businessId])
  @@index([businessId, goodsReceiptLineId, createdAt])
  @@index([businessId, purchaseOrderLineId])
  @@map("goods_receipt_reversals")
}

model InventoryPurchasingCommand {
  id                 String                         @id @default(uuid()) @db.Uuid
  businessId         String                         @map("business_id") @db.Uuid
  operationKey       String                         @map("operation_key") @db.VarChar(180)
  commandType        InventoryPurchasingCommandType @map("command_type")
  requestFingerprint String                         @map("request_fingerprint") @db.VarChar(64)
  resultEntityType   String                         @map("result_entity_type") @db.VarChar(50)
  resultEntityId     String                         @map("result_entity_id") @db.Uuid
  actorUserId        String                         @map("actor_user_id") @db.Uuid
  createdAt          DateTime                       @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor    User     @relation("InventoryPurchasingCommandActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([businessId, operationKey])
  @@index([businessId, commandType, createdAt])
  @@map("inventory_purchasing_commands")
}

model SupplierBill {
  id                              String                    @id @default(uuid()) @db.Uuid
  businessId                      String                    @map("business_id") @db.Uuid
  branchId                        String                    @map("branch_id") @db.Uuid
  supplierId                      String                    @map("supplier_id") @db.Uuid
  purchaseOrderId                 String                    @map("purchase_order_id") @db.Uuid
  billNumber                      String                    @map("bill_number") @db.VarChar(40)
  supplierInvoiceNumber           String                    @map("supplier_invoice_number") @db.VarChar(120)
  supplierInvoiceNumberNormalized String                    @map("supplier_invoice_number_normalized") @db.VarChar(120)
  status                          SupplierBillStatus        @default(DRAFT)
  paymentStatus                   SupplierBillPaymentStatus @default(UNPAID) @map("payment_status")
  matchStatus                     SupplierBillMatchStatus   @default(RECEIPT_PENDING) @map("match_status")
  invoiceDate                     DateTime                  @map("invoice_date") @db.Date
  dueDate                         DateTime                  @map("due_date") @db.Date
  currency                        String                    @default("MYR") @db.VarChar(3)
  subtotal                        Decimal                   @default(0) @db.Decimal(12, 2)
  totalAmount                     Decimal                   @default(0) @map("total_amount") @db.Decimal(12, 2)
  priceVarianceAcknowledged       Boolean                   @default(false) @map("price_variance_acknowledged")
  priceVarianceReason             String?                   @map("price_variance_reason")
  notes                           String?
  revision                        Int                       @default(0)
  createdById                     String                    @map("created_by_id") @db.Uuid
  confirmedById                   String?                   @map("confirmed_by_id") @db.Uuid
  confirmedAt                     DateTime?                 @map("confirmed_at")
  confirmedRevision               Int?                      @map("confirmed_revision")
  voidedById                      String?                   @map("voided_by_id") @db.Uuid
  voidedAt                        DateTime?                 @map("voided_at")
  voidReason                      String?                   @map("void_reason")
  createdAt                       DateTime                  @default(now()) @map("created_at")
  updatedAt                       DateTime                  @updatedAt @map("updated_at")

  business      Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch        Branch                  @relation(fields: [branchId, businessId], references: [id, businessId], onDelete: Restrict)
  supplier      Supplier                @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Restrict)
  purchaseOrder PurchaseOrder           @relation(fields: [purchaseOrderId, businessId], references: [id, businessId], onDelete: Restrict)
  createdBy     User                    @relation("SupplierBillCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy   User?                   @relation("SupplierBillConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  voidedBy      User?                   @relation("SupplierBillVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  lines         SupplierBillLine[]
  attachment    SupplierBillAttachment?
  payments      SupplierPayment[]

  @@unique([id, businessId])
  @@unique([businessId, billNumber])
  @@index([businessId, branchId, status, dueDate])
  @@index([businessId, supplierId, status, dueDate])
  @@index([businessId, purchaseOrderId, status])
  @@map("supplier_bills")
}

model SupplierBillLine {
  id                       String   @id @default(uuid()) @db.Uuid
  businessId               String   @map("business_id") @db.Uuid
  supplierBillId           String   @map("supplier_bill_id") @db.Uuid
  purchaseOrderLineId      String   @map("purchase_order_line_id") @db.Uuid
  productId                String   @map("product_id") @db.Uuid
  descriptionSnapshot      String   @map("description_snapshot") @db.VarChar(240)
  billedQuantity           Int      @map("billed_quantity")
  unitPrice                Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal                Decimal  @map("line_total") @db.Decimal(12, 2)
  orderedQuantitySnapshot  Int      @map("ordered_quantity_snapshot")
  netReceivedSnapshot      Int      @map("net_received_snapshot")
  previouslyBilledSnapshot Int      @map("previously_billed_snapshot")
  createdAt                DateTime @default(now()) @map("created_at")

  business          Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
