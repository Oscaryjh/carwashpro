  messages WhatsAppChatMessage[]

  @@unique([businessId, instanceId, phone])
  @@index([businessId])
  @@index([businessId, instanceId])
  @@index([customerId])
  @@index([remoteJid])
  @@index([lastMessageAt])
  @@map("whatsapp_conversations")
}

model WhatsAppChatMessage {
  id                String                    @id @default(uuid()) @db.Uuid
  businessId        String                    @map("business_id") @db.Uuid
  instanceId        String                    @default("default") @map("instance_id")
  conversationId    String                    @map("conversation_id") @db.Uuid
  customerId        String?                   @map("customer_id") @db.Uuid
  sentByUserId      String?                   @map("sent_by_user_id") @db.Uuid
  direction         WhatsAppChatDirection
  messageType       WhatsAppChatMessageType   @default(TEXT) @map("message_type")
  body              String
  mediaUrl          String?                   @map("media_url")
  mediaMimeType     String?                   @map("media_mime_type")
  mediaFileName     String?                   @map("media_file_name")
  status            WhatsAppChatMessageStatus @default(SENT)
  externalMessageId String?                   @map("external_message_id")
  rawMessageJson    Json?                     @map("raw_message_json")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sentByUser   User?                @relation("WhatsAppChatMessageSender", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@unique([businessId, instanceId, externalMessageId], map: "whatsapp_chat_messages_business_id_instance_id_external_message")
  @@index([businessId])
  @@index([businessId, instanceId])
  @@index([conversationId])
  @@index([customerId])
  @@index([sentByUserId])
  @@index([messageType])
  @@index([createdAt])
  @@map("whatsapp_chat_messages")
}

