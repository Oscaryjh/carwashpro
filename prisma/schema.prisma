  messageLog           WhatsAppMessage?             @relation(fields: [messageLogId], references: [id], onDelete: SetNull)
  appointment          Appointment?                 @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  dailyClosingSnapshot DailyClosingSnapshot?        @relation(fields: [dailyClosingSnapshotId], references: [id], onDelete: SetNull)
  closingWhatsAppSends ClosingWhatsAppSendAttempt[]
  sendAttempts         WhatsAppSendAttempt[]

  @@unique([id, businessId], map: "notification_queue_id_business_id_key")
  @@index([businessId])
  @@index([branchId])
  @@index([messageLogId])
  @@index([appointmentId])
  @@index([dailyClosingSnapshotId])
  @@index([providerMessageId])
  @@index([status])
  @@index([status, priority, queuedAt])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@map("notification_queue")
}

model WhatsAppSendAttempt {
  id                String    @id @default(uuid()) @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  queueId           String    @map("queue_id") @db.Uuid
  attemptNumber     Int       @map("attempt_number")
  claimToken        String    @map("claim_token") @db.Uuid
  status            String
  retryable         Boolean?
  errorCategory     String?   @map("error_category")
  errorMessage      String?   @map("error_message")
  providerMessageId String?   @map("provider_message_id")
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  queue NotificationQueue @relation(fields: [queueId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([queueId, attemptNumber], map: "whatsapp_send_attempts_queue_attempt_key")
  @@index([businessId, startedAt])
  @@index([queueId, startedAt])
  @@index([status, startedAt])
  @@map("whatsapp_send_attempts")
}

model WhatsAppWebhookEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  businessId         String    @map("business_id") @db.Uuid
  instanceId         String    @default("default") @map("instance_id")
  provider           String
  eventKey           String    @map("event_key")
  eventType          String    @map("event_type")
  providerMessageId  String?   @map("provider_message_id")
  payloadFingerprint String    @map("payload_fingerprint")
  providerOccurredAt DateTime? @map("provider_occurred_at")
  receivedAt         DateTime  @default(now()) @map("received_at")
  lastReceivedAt     DateTime  @default(now()) @map("last_received_at")
  expiresAt          DateTime  @map("expires_at")
  duplicateCount     Int       @default(0) @map("duplicate_count")
  effectApplied      Boolean   @default(false) @map("effect_applied")
  outcome            String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, provider, eventKey], map: "whatsapp_webhook_events_business_provider_event_key")
  @@index([businessId, providerMessageId])
  @@index([expiresAt])
  @@index([eventType, receivedAt])
  @@map("whatsapp_webhook_events")
}
