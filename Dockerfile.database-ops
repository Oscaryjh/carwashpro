FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
  && install -d /usr/share/postgresql-common/pgdg \
  && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    | gpg --dearmor -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg \
  && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
    > /etc/apt/sources.list.d/pgdg.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends postgresql-18 postgresql-client-18 \
  && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/lib/postgresql/18/bin:${PATH}"
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY scripts/lib/database-backup-core.mjs scripts/lib/database-backup-core.mjs
COPY scripts/lib/database-restore-runtime.mjs scripts/lib/database-restore-runtime.mjs
COPY scripts/db-backup.mjs scripts/db-backup.mjs
COPY scripts/db-restore-verify.mjs scripts/db-restore-verify.mjs

RUN chown -R node:node /app
USER node

CMD ["node", "scripts/db-backup.mjs"]
