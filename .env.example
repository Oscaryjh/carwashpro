DATABASE_URL="postgresql://postgres:postgres@localhost:5432/car_wash_crm_pos?schema=public"
LOCAL_POSTGRES_PORT=5432
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Versioned AES-256-GCM keys for immutable statutory export artifacts.
# Each value must be a 32-byte key encoded as base64 or 64-character hex.
STATUTORY_ARTIFACT_ACTIVE_KEY_VERSION="v1"
STATUTORY_ARTIFACT_ENCRYPTION_KEYS='{"v1":"replace-with-a-base64-encoded-32-byte-key"}'
# Employee Attendance authentication is independent from the admin session.
EMPLOYEE_AUTH_SECRET="replace-with-an-independent-32-byte-secret"
# Mock is permitted only for local development and Testing; Production fails closed.
EMPLOYEE_OTP_SEND_MODE="mock"
EMPLOYEE_OTP_MOCK_ACCESS_KEY=""
# Optional fixed code for local development and Testing only. Production rejects it.
EMPLOYEE_OTP_MOCK_CODE=""
EMPLOYEE_OTP_EXPIRES_SECONDS=300
EMPLOYEE_OTP_MAX_ATTEMPTS=5
EMPLOYEE_OTP_RESEND_SECONDS=60
EMPLOYEE_OTP_PHONE_HOURLY_LIMIT=5
EMPLOYEE_OTP_IP_HOURLY_LIMIT=20
EMPLOYEE_OTP_DEVICE_HOURLY_LIMIT=10
EMPLOYEE_OTP_PROVIDER_HOURLY_LIMIT=1000
EMPLOYEE_SESSION_EXPIRES_SECONDS=604800
ATTENDANCE_WRITE_RATE_WINDOW_MILLISECONDS=60000
ATTENDANCE_PUNCH_REQUESTS_PER_WINDOW=60
ATTENDANCE_EXCEPTION_REQUESTS_PER_WINDOW=30
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
# Enable versioned daily summaries for All Stores after migrations/backfill.
ANALYTICS_DAILY_SUMMARY_READ_MODE="OFF"
# Run `npm run analytics:worker` as a separate production worker.
# Allowed polling interval: 1000-300000 milliseconds.
ANALYTICS_REFRESH_POLL_MS=15000
WHATSAPP_CONNECTOR_URL="http://127.0.0.1:8787"
# Shared secret used by WashFlow and the Connector HTTP API.
WHATSAPP_CONNECTOR_API_SECRET=""
WHATSAPP_INCOMING_BUSINESS_ID=""
WHATSAPP_WEBHOOK_SECRET=""
# Notification Queue worker send mode.
# Use "mock" for local and Testing smoke tests so no Connector HTTP request is made.
# Production must explicitly set "live" before real sending is allowed.
# Missing or invalid values make the worker refuse to send.
WHATSAPP_SEND_MODE="mock"
