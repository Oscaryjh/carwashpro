DATABASE_URL="postgresql://postgres:postgres@localhost:5432/car_wash_crm_pos?schema=public"
APP_ENVIRONMENT="development"
APP_RELEASE_SHA=""
APP_RELEASE_SOURCE_DIGEST=""
STAFF_APP_ORIGIN=""
LOCAL_POSTGRES_PORT=5432
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Dedicated versioned AES-256-GCM keyring for TOTP secrets.
MFA_ACTIVE_KEY_VERSION="v1"
MFA_ENCRYPTION_KEYS='{"v1":"replace-with-a-different-base64-encoded-32-byte-key"}'
# Versioned AES-256-GCM keys for immutable statutory export artifacts.
# Each value must be a 32-byte key encoded as base64 or 64-character hex.
STATUTORY_ARTIFACT_ACTIVE_KEY_VERSION="v1"
STATUTORY_ARTIFACT_ENCRYPTION_KEYS='{"v1":"replace-with-a-base64-encoded-32-byte-key"}'
PAYROLL_PAYMENT_ACTIVE_KEY_VERSION="v1"
PAYROLL_PAYMENT_ENCRYPTION_KEYS='{"v1":"replace-with-a-different-base64-encoded-32-byte-key"}'
PAYROLL_PAYMENT_FINGERPRINT_KEY="replace-with-an-independent-high-entropy-hmac-key"
# Temporary product-wide switch. Set true later to restore MFA enrollment,
# challenges and step-up verification without changing stored MFA records.
TETAMU_MFA_ENABLED=false
# Optional bank-account override. It is only read when the master switch above
# is enabled; Production then remains fail-closed.
PAYROLL_BANK_ACCOUNT_MFA_ENABLED=false
# Employee Attendance authentication is independent from the admin session.
EMPLOYEE_AUTH_SECRET="replace-with-an-independent-32-byte-secret"
# Provider-neutral Staff OTP. Local automated tests use mock; Online Testing
# may use Twilio Verify or SMS123 SMS. NODE_ENV=production always rejects mock.
OTP_PROVIDER="mock"
OTP_CHANNEL="local"
# Legacy alias accepted during migration; prefer OTP_PROVIDER.
EMPLOYEE_OTP_SEND_MODE="mock"
EMPLOYEE_OTP_MOCK_ACCESS_KEY=""
# Optional fixed code for local development and Testing only. Production rejects it.
EMPLOYEE_OTP_MOCK_CODE=""
EMPLOYEE_OTP_EXPIRES_SECONDS=300
EMPLOYEE_OTP_MAX_ATTEMPTS=5
EMPLOYEE_OTP_RESEND_SECONDS=60
EMPLOYEE_OTP_PHONE_HOURLY_LIMIT=5
EMPLOYEE_OTP_IP_HOURLY_LIMIT=20
EMPLOYEE_OTP_DEVICE_HOURLY_LIMIT=10
EMPLOYEE_OTP_PROVIDER_HOURLY_LIMIT=1000
STAFF_OTP_VERIFY_PHONE_HOURLY_LIMIT=10
STAFF_OTP_VERIFY_IP_HOURLY_LIMIT=30
STAFF_OTP_PROVIDER_TIMEOUT_MS=10000
# Server-only Twilio Verify values. Never use NEXT_PUBLIC_ names.
TWILIO_ACCOUNT_SID=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
# Server-only SMS123 API key. Obtain it from SMS123 > My Account > Settings
# (also shown as Manage API). Never use a NEXT_PUBLIC_ name.
SMS123_API_KEY=""
# Sliding Staff App inactivity timeout. Each active return extends the session.
EMPLOYEE_SESSION_EXPIRES_SECONDS=604800
ATTENDANCE_WRITE_RATE_WINDOW_MILLISECONDS=60000
ATTENDANCE_PUNCH_REQUESTS_PER_WINDOW=60
ATTENDANCE_EXCEPTION_REQUESTS_PER_WINDOW=30
# Local/Testing seed values. Production requires explicit unique values.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="LOCAL_ONLY_CHANGE_ME"
# Production bootstrap is fail-closed. The Production Owner must deliberately
# enable it once and supply unique strong credentials.
ALLOW_PRODUCTION_PLATFORM_ADMIN_BOOTSTRAP=false
# Enable versioned daily summaries for All Stores after migrations/backfill.
ANALYTICS_DAILY_SUMMARY_READ_MODE="OFF"
# Run `npm run analytics:worker` as a separate production worker.
# Allowed polling interval: 1000-300000 milliseconds.
ANALYTICS_REFRESH_POLL_MS=15000
# Read-only AI Business Analysis. Local/Testing may use mock; Production mock fails closed.
AI_PROVIDER=mock
AI_GLOBAL_ENABLED=false
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
EXPENSE_RECEIPT_AUTOFILL_ENABLED=false
EXPENSE_DOCUMENT_AI_ENABLED=false
EXPENSE_DOCUMENT_AI_PROVIDER=mock
EXPENSE_DOCUMENT_AI_MODEL=gpt-5.4-mini
EXPENSE_DOCUMENT_AI_MAX_OUTPUT_TOKENS=1200
AI_REQUESTS_PER_USER_MINUTE=6
AI_REQUESTS_PER_SCOPE_MINUTE=30
WHATSAPP_CONNECTOR_URL="http://127.0.0.1:8787"
# Shared secret used by WashFlow and the Connector HTTP API.
WHATSAPP_CONNECTOR_API_SECRET=""
WHATSAPP_INCOMING_BUSINESS_ID=""
WHATSAPP_WEBHOOK_SECRET=""
# Notification Queue worker send mode.
# Use "mock" for local and Testing smoke tests so no Connector HTTP request is made.
# Production must explicitly set "live" before real sending is allowed.
# Missing or invalid values make the worker refuse to send.
WHATSAPP_SEND_MODE="mock"
# Claim receipts are private and fail closed unless an explicit provider is
# configured. Use filesystem only with a durable non-public local volume.
# Railway Testing uses a private S3-compatible bucket (Cloudflare R2).
CLAIM_PRIVATE_STORAGE_PROVIDER=
CLAIM_PRIVATE_STORAGE_ROOT=
CLAIM_PRIVATE_STORAGE_S3_ENDPOINT=
CLAIM_PRIVATE_STORAGE_S3_REGION=auto
CLAIM_PRIVATE_STORAGE_S3_BUCKET=
CLAIM_PRIVATE_STORAGE_S3_ACCESS_KEY_ID=
CLAIM_PRIVATE_STORAGE_S3_SECRET_ACCESS_KEY=
CLAIM_PRIVATE_STORAGE_S3_PREFIX=
CLAIM_PRIVATE_STORAGE_S3_FORCE_PATH_STYLE=false
# Logos/profile photos use their own image-only namespace; never a receipt prefix.
# Local defaults to filesystem. Railway Staff must use durable S3 storage.
PUBLIC_IMAGE_STORAGE_PROVIDER=
PUBLIC_IMAGE_S3_ENDPOINT=
PUBLIC_IMAGE_S3_REGION=auto
PUBLIC_IMAGE_S3_BUCKET=
PUBLIC_IMAGE_S3_ACCESS_KEY_ID=
PUBLIC_IMAGE_S3_SECRET_ACCESS_KEY=
PUBLIC_IMAGE_S3_PREFIX=public-images/testing/v1
PUBLIC_IMAGE_S3_FORCE_PATH_STYLE=false
# HTTPS serving origin, so older POS versions can display newly uploaded photos.
PUBLIC_IMAGE_BASE_URL=
# Optional trusted POS origin for files still stored on the POS upload volume.
PUBLIC_IMAGE_LEGACY_ORIGIN=

# Backend performance targets. Default OFF; enable only after its reviewed migration.
# This does not enable Phase 1 capture or backfill historical receipts.
TETAMU_PERFORMANCE_PHASE2=false

# Staff read-only performance. Independent of capture/targets, default OFF.
TETAMU_STAFF_PERFORMANCE=false
